;;; scientific-controls.el --- Compact secondary scientific controls -*- lexical-binding: t; -*-
(defun calc-scientific-controls (program)
  "Add one compact secondary-function selector to the scientific page."
  (let (forms setup dispatch (index 0))
    (dolist (item '(("More scientific functions" nil)
                    ("GRAD" "angle:grad") ("π" "function:pi") ("e" "function:e")
                    ("asin" "function:asin") ("acos" "function:acos") ("atan" "function:atan")
                    ("sinh" "function:sinh") ("cosh" "function:cosh") ("tanh" "function:tanh")
                    ("asinh" "function:asinh") ("acosh" "function:acosh") ("atanh" "function:atanh")
                    ("10^x" "function:pow10") ("2^x" "function:pow2") ("Cube root" "function:cuberoot")))
      (let ((label (intern (format "science_label_%d" index)))
            (token (intern (format "science_token_%d" index))))
        (push `(data-blob ,label ,(concat (car item) "\0") rodata) forms)
        (push `(extern-call gtk_combo_box_text_append_text selector (data-addr ,label)) setup)
        (when (cadr item)
          (push `(data-blob ,token ,(concat (cadr item) "\n\0") rodata) forms)
          (push (list index token) dispatch)))
      (setq index (1+ index)))
    (let ((tail 0))
      (dolist (row dispatch)
        (setq tail `(if (= selected ,(car row)) (send_command ctx (data-addr ,(cadr row))) ,tail)))
      (push `(defun on_scientific_secondary (widget ctx)
               (let ((selected (extern-call gtk_combo_box_get_active widget)))
                 (if (> selected 0)
                     (seq ,tail (extern-call gtk_combo_box_set_active widget 0)
                          (extern-call gtk_widget_grab_focus (ptr-read-u64 ctx 8))
                          (let ((fp (extern-call fopen (data-addr science_geometry_file) (data-addr append_mode))))
                            (if (= fp 0) 0
                              (seq
                                   (extern-call gtk_widget_measure (ptr-read-u64 ctx 3288) 0 -1 (+ ctx 7408) (+ ctx 7416) 0 0)
                                   (extern-call gtk_widget_measure (ptr-read-u64 ctx 3288) 1 440 (+ ctx 7424) (+ ctx 7432) 0 0)
                                   (extern-call gtk_widget_measure widget 1 440 (+ ctx 7440) (+ ctx 7448) 0 0)
                                   (extern-call fprintf fp (data-addr science_geometry_format)
                                     (ptr-read-u64 ctx 7416) (ptr-read-u64 ctx 7432) (ptr-read-u64 ctx 7448))
                                   (extern-call fclose fp))))) 0))) forms))
    (push `(defun setup_scientific_secondary (ctx page)
             (let ((selector (extern-call gtk_combo_box_text_new)))
               (seq (ptr-write-u64 ctx 7400 selector) ,@(nreverse setup)
                    (extern-call gtk_combo_box_set_active selector 0)
                    (extern-call g_signal_connect_data selector (data-addr science_changed) (addr-of on_scientific_secondary) ctx 0 0)
                    (let ((help (extern-call gtk_grid_get_child_at page 0 0)))
                      (if (= help 0) 0 (extern-call gtk_widget_set_visible help 0)))
                    (extern-call gtk_grid_attach page selector 0 0 4 1) 0))) forms)
    (push '(data-blob science_changed "changed\0" rodata) forms)
    (push '(data-blob science_geometry_file "scientific-controls.tsv\0" rodata) forms)
    (push '(data-blob science_geometry_format "%ld\t%ld\t%ld\n\0" rodata) forms)
    (push '(data-blob science_prefix "science:select:\0" rodata) forms)
    (push '(data-blob science_focus_command "ui:focus:science\0" rodata) forms)
    (cl-labels ((walk (node)
                 (if (not (consp node)) node
                   (if (equal node '(setup_product_page ctx page (data-addr mode_scientific)))
                       `(seq ,node (setup_scientific_secondary ctx page))
                     (mapcar #'walk node)))))
      (append (mapcar (lambda (form)
                        (if (and (eq (car-safe form) 'defun) (eq (cadr form) 'emit_command))
                            `(defun emit_command (ctx command)
                               (if (= (extern-call strcmp command (data-addr science_focus_command)) 0)
                                   (extern-call gtk_window_set_focus (ptr-read-u64 ctx 3288) (ptr-read-u64 ctx 7400))
                                 (if (= (extern-call strncmp command (data-addr science_prefix) 15) 0)
                                   (extern-call gtk_combo_box_set_active (ptr-read-u64 ctx 7400) (extern-call atoi (+ command 15)))
                                 ,(nth 3 form))))
                          (walk form))) program) (nreverse forms)))))
