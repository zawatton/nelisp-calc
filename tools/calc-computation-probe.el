;;; calc-computation-probe.el --- Real Calc phase probe -*- lexical-binding: t; -*-
(defvar computation-root
  (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t))))
(setq nelisp-calc-root computation-root)
(load (or (getenv "CALC_COMPUTATION_ENGINE")
          (expand-file-name "lisp/nelisp-calc-engine.el" computation-root)) nil t)
(nelisp-calc-initialize-owned-backend t)
(when nelisp-calc-engine-error (error "%s" nelisp-calc-engine-error))
(defvar computation-results nil)
(defmacro computation-time (label &rest body)
  `(let* ((start (float-time)) (value (progn ,@body)))
     (push (list ,label (* 1000 (- (float-time) start))) computation-results)
     value))
(defvar computation-counters nil)
(defun computation-wrap (name)
  (let ((original (symbol-function name)))
    (fset name
          (lambda (&rest args)
            (let* ((start (float-time)) (value (apply original args))
                   (elapsed (* 1000 (- (float-time) start)))
                   (counter (assq name computation-counters)))
              (if counter (setcdr counter (+ (cdr counter) elapsed))
                (push (cons name elapsed) computation-counters))
              value)))))
(dolist (name '(math-read-preprocess-string math-build-parse-table math-read-token
                math-read-expr-list nelisp-calc-session-record nelisp-calc-session-publish))
  (computation-wrap name))
(dolist (expression '("123+456" "(123)+(456)" "123+456" "(123)+(456)" "0.1+0.2" "1/3+1/6" "sqrt(2)" "sin(30)" "123+456"))
  (let* ((computation-results nil)
         (calc-internal-prec nelisp-calc-precision)
         (calc-angle-mode nelisp-calc-angle)
         (calc-simplify-mode nil)
         (parsed (computation-time 'parse (math-read-exprs expression)))
         (parsed (computation-time 'constants (mapcar #'nelisp-calc-expand-constants parsed)))
         (normalized (computation-time 'normalize (calc-normalize (car parsed))))
         (constant (computation-time 'constp (math-constp normalized)))
         (value (computation-time 'format (math-format-value normalized 1000))))
    (princ (format "PHASE %s %S %S\n" expression value (nreverse computation-results)))))
(let ((computation-results nil))
  (dolist (token '("clear" "1" "2" "3" "add" "4" "5" "6" "equals" "equals"))
    (computation-time token (nelisp-calc-token token)))
  (princ (format "TOKENS %S %S %S\n" (nreverse computation-results) nelisp-calc-display nelisp-calc-session-history)))
(princ (format "COUNTERS %S\n" computation-counters))
(dotimes (round 4)
  (let ((computation-results nil))
    (computation-time 'grouped
      (unless (equal (nelisp-calc-apply "(123)+(456)") "579") (error "Grouped mismatch")))
    (computation-time 'binary
      (unless (equal (nelisp-calc-binary "123" "+" "456") "579") (error "Binary mismatch")))
    (princ (format "PAIR %d %S\n" round (nreverse computation-results)))))
(dolist (case '(("123" "+" "456" "579") ("0.1" "+" "0.2" "0.3")
                ("8" "-" "13" "-5") ("1" "/" "8" "0.125")
                ("12.5" "*" "4" "50") ("-2" "*" "3" "-6")
                ("1:3" "+" "1:6" "1:2") ("1e3" "+" "2" "1002")
                ("1+2" "*" "4" "12")))
  (let ((actual (nelisp-calc-binary (nth 0 case) (nth 1 case) (nth 2 case))))
    (unless (equal actual (nth 3 case)) (error "Binary case %S => %S" case actual))))
(dolist (case '((deg "sin(30)" "0.5") (rad "sin(0)" "0") (grad "sin(100)" "1")))
  (let ((nelisp-calc-angle (nth 0 case)))
    (unless (equal (plist-get (nelisp-calc-evaluate (nth 1 case)) :value) (nth 2 case))
      (error "Angle case %S" case))))
(unless (equal (plist-get (nelisp-calc-evaluate "sqrt(2)" 20) :value) "1.4142135623730950488")
  (error "Precision case failed"))
(when (plist-get (nelisp-calc-evaluate "(") :ok) (error "Parse error accepted"))
(when (nelisp-calc-binary "1" "/" "0") (error "Division error accepted"))
(unless (equal nelisp-calc-session-history '(("579 + 456" . "1035") ("123 + 456" . "579")))
  (error "History/repeated-equals mismatch"))
(let ((original (symbol-function 'nelisp-calc-apply)) rendered)
  (unwind-protect
      (progn
        (fset 'nelisp-calc-apply (lambda (expression) (setq rendered expression)))
        (nelisp-calc-binary "123" "+" "456")
        (unless (equal rendered "123+456") (error "Redundant grouping: %s" rendered))
        (nelisp-calc-binary "1." "+" "2.")
        (unless (equal rendered "(1.)+(2.)") (error "Trailing decimal lost grouping"))
        (nelisp-calc-binary "-2" "*" "3")
        (unless (equal rendered "(-2)*(3)") (error "Negative lost grouping"))
        (nelisp-calc-binary "1e3" "+" "2")
        (unless (equal rendered "(1e3)+(2)") (error "Scientific lost grouping"))
        (nelisp-calc-binary "1:3" "+" "1:6")
        (unless (equal rendered "(1:3)+(1:6)") (error "Fraction lost grouping")))
    (fset 'nelisp-calc-apply original)))
(princ "COMPUTATION-PASS 9 binary cases, 3 angles, precision, errors, history, grouping\n")
