;;; direct-calc-probe.el --- Genuine number reader probe -*- lexical-binding: t; -*-
(defvar direct-start (float-time))
(defvar direct-root
  (expand-file-name ".." (file-name-directory
                         (replace-regexp-in-string "\\\\" "/" load-file-name t t))))
(setq nelisp-calc-root direct-root)
(defvar direct-baseline-path
  (or (getenv "DIRECT_CALC_BASELINE")
      (expand-file-name "target/direct-baseline-engine.el" direct-root)))
(load direct-baseline-path nil t)
(defvar direct-baseline-binary (symbol-function 'nelisp-calc-binary))
(load (or (getenv "DIRECT_CALC_ENGINE")
          (expand-file-name "lisp/nelisp-calc-engine.el" direct-root)) nil t)
(nelisp-calc-initialize-owned-backend t)
(when nelisp-calc-engine-error (error "%s" nelisp-calc-engine-error))
(princ (format "READY-MS %.3f\n" (* 1000 (- (float-time) direct-start))))
(defvar direct-checks 0)
(defmacro direct-check (condition)
  `(progn (unless ,condition (error "Direct check failed: %S" ',condition))
          (setq direct-checks (1+ direct-checks))))
(dolist (calc-internal-prec '(2 12 30))
  (dolist (text '("0" "0009" "123" "0.1" "0.000" "123456789012345678901234567890" "1.234567890123456789"))
    (direct-check (equal (list (math-read-number text)) (math-read-exprs text)))))
(princ (format "READER-PASS %d\n" direct-checks))
(defvar direct-preprocess-count 0)
(defvar direct-preprocess-original (symbol-function 'math-read-preprocess-string))
(fset 'math-read-preprocess-string
      (lambda (&rest args)
        (setq direct-preprocess-count (1+ direct-preprocess-count))
        (apply direct-preprocess-original args)))
(defvar direct-current-binary (symbol-function 'nelisp-calc-binary))
(defvar direct-pairs nil)
(defun direct-state ()
  (list nelisp-calc-display nelisp-calc-status nelisp-calc-expression nelisp-calc-fresh))
(dolist (nelisp-calc-precision '(2 12 30))
  (dolist (case '(("123" "+" "456" "579") ("0.1" "+" "0.2" "0.3")
                  ("8" "-" "13" "-5") ("1" "/" "8" "0.125")
                  ("12.5" "*" "4" "50") ("0009" "+" "001" "10")
                  ("0" "-" "0" "0") ("0.000" "*" "4" "0")
                  ("9007199254740993" "+" "2" "9007199254740995")
                  ("123456789012345678901234567890" "+" "1" "123456789012345678901234567891")
                  ("1.234567890123456789" "+" "0.000000000000000001")
                  ("1" "/" "3") ("1" "/" "0") ("-0" "*" "3")
                  ("-2" "*" "3" "-6") ("1:3" "+" "1:6" "1:2")
                  ("1e3" "+" "2" "1002") ("1+2" "*" "4" "12")
                  ("1." "+" "2." "3") ("(" "+" "2")))
    (nelisp-calc-reset)
    (let* ((args (list (nth 0 case) (nth 1 case) (nth 2 case)))
           (expected (apply direct-baseline-binary args))
           (expected-state (direct-state)))
      (nelisp-calc-reset)
      (direct-check (equal (apply direct-current-binary args) expected))
      (direct-check (equal (direct-state) expected-state))
      (when (and (>= nelisp-calc-precision 12) (nth 3 case))
        (direct-check (equal expected (nth 3 case)))))))
(princ (format "MATRIX-PASS %d checks (20 cases x 3 precisions)\n" direct-checks))
;; Customization must retain the genuine text path, including ASCII replacements.
(let ((calc-language-input-filter (lambda (text) (concat text "+1"))))
  (direct-check (equal (nelisp-calc-binary "2" "+" "3") "6")))
(let ((math-read-replacement-list (cons '("2" "4") math-read-replacement-list)))
  (direct-check (equal (nelisp-calc-binary "2" "+" "3") "7")))
(let* ((source (copy-sequence "x"))
       (math-read-replacement-list (cons (list source "4") math-read-replacement-list)))
  (direct-check (equal (nelisp-calc-binary "2" "+" "3") "5"))
  (aset source 0 ?2)
  ;; GNU caches preprocessing by list identity. Refresh that independent cache
  ;; so both readers observe the newly edited source string in this assertion.
  (setq math--read-preprocess-re-cache nil)
  (direct-check (equal (nelisp-calc-binary "2" "+" "3") "7")))
(let* ((entry (car math-read-replacement-list))
       (source (car entry)) (replacement (cadr entry)))
  (unwind-protect
      (progn
        (direct-check (equal (nelisp-calc-binary "2" "+" "3") "5"))
        (setcar entry "2")
        (setcar (cdr entry) "4")
        (setq math--read-preprocess-re-cache nil)
        (let ((direct-preprocess-count 0))
          (direct-check (equal (nelisp-calc-binary "2" "+" "3") "7"))
          (direct-check (= direct-preprocess-count 1))))
    (setcar entry source)
    (setcar (cdr entry) replacement)
    (setq math--read-preprocess-re-cache nil)))
(dolist (case '((deg "sin(30)" "0.5") (rad "sin(0)" "0") (grad "sin(100)" "1")))
  (let ((nelisp-calc-angle (car case)))
    (direct-check (equal (plist-get (nelisp-calc-evaluate (nth 1 case)) :value) (nth 2 case)))))
(direct-check (equal (plist-get (nelisp-calc-evaluate "sqrt(2)" 20) :value) "1.4142135623730950488"))
(let ((nelisp-calc-engine-error "negative-control"))
  (direct-check (null (nelisp-calc-binary "2" "+" "3")))
  (direct-check (equal nelisp-calc-display "ERROR"))
  (direct-check (equal nelisp-calc-status "engine-unavailable:negative-control")))
(princ (format "SEMANTICS-PASS %d\n" direct-checks))
;; This assertion must fail on the archived engine, after its numerical checks pass.
(let ((direct-preprocess-count 0))
  (direct-check (equal (nelisp-calc-binary "123" "+" "456") "579"))
  (direct-check (= direct-preprocess-count 0)))
(dolist (args '(("-2" "+" "3") ("1." "+" "2.") ("1e3" "+" "2") ("1:3" "+" "1:6")))
  (let ((direct-preprocess-count 0))
    (apply direct-current-binary args)
    (direct-check (= direct-preprocess-count 1))))
(princ (format "PATH-PASS %d\n" direct-checks))
(defun direct-time-call (function args)
  (let* ((direct-preprocess-count 0)
         (start (float-time))
         (value (apply function args))
         (milliseconds (* 1000 (- (float-time) start))))
    (list milliseconds direct-preprocess-count value)))
;; Warm both paths before paired timings, with normal application GC policy.
(dolist (function (list direct-baseline-binary direct-current-binary))
  (funcall function "123" "+" "456"))
(dotimes (round 4)
  (dolist (args '(("123" "+" "456") ("0.1" "+" "0.2") ("12.5" "*" "4") ("1" "/" "8")))
    (let ((baseline (direct-time-call direct-baseline-binary args))
          (current (direct-time-call direct-current-binary args)))
      (direct-check (equal (nth 2 baseline) (nth 2 current)))
      (push (list 'binary round args baseline current) direct-pairs))))
(defun direct-token-sequence (binary)
  (unwind-protect
      (progn
        (fset 'nelisp-calc-binary binary)
        (setq nelisp-calc-mode "standard" nelisp-calc-session-history nil)
        (nelisp-calc-token "clear")
        (let (times)
          (dolist (token '("1" "2" "3" "add" "4" "5" "6" "equals" "equals"))
            (push (cons token (direct-time-call #'nelisp-calc-token (list token))) times))
          (direct-check (equal nelisp-calc-display "1035"))
          (direct-check (equal nelisp-calc-session-history '(("579 + 456" . "1035") ("123 + 456" . "579"))))
          (nreverse times)))
    (fset 'nelisp-calc-binary direct-current-binary)))
(dotimes (round 4)
  (let ((baseline (direct-token-sequence direct-baseline-binary))
        (current (direct-token-sequence direct-current-binary)))
    (push (list 'tokens round baseline current) direct-pairs)))
(dolist (pair (nreverse direct-pairs)) (princ (format "PAIR %S\n" pair)))
(princ (format "DIRECT-CALC-PASS %d checks\n" direct-checks))
