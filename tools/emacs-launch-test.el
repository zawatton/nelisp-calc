;;; emacs-launch-test.el --- Host launcher tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defconst nelisp-calc-test--root
  (expand-file-name ".." (file-name-directory (or load-file-name buffer-file-name))))
(add-to-list 'load-path (expand-file-name "lisp" nelisp-calc-test--root))
(require 'nelisp-calc)

(ert-deftest nelisp-calc-load-is-inert ()
  (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Started at load"))))
    (load (expand-file-name "lisp/nelisp-calc.el" nelisp-calc-test--root) nil t))
  (should-not (featurep 'nelisp-calc-engine)))

(ert-deftest nelisp-calc-root-default ()
  (let ((nelisp-calc-project-root nil))
    (should (equal (file-truename (nelisp-calc--root))
                   (file-name-as-directory (file-truename nelisp-calc-test--root))))))

(ert-deftest nelisp-calc-argv-activation-without-emacs-focus ()
  (let ((nelisp-calc-project-root "C:/test directory/app")
        (nelisp-calc--process nil) captured hidden)
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "C:/shell directory/pwsh.exe"))
              ((symbol-function 'file-regular-p) (lambda (_) t))
              ((symbol-function 'make-process)
               (lambda (&rest args) (setq captured args hidden w32-start-process-show-window) 'fake))
              ((symbol-function 'display-buffer) (lambda (&rest _) (ert-fail "Displayed buffer")))
              ((symbol-function 'select-frame-set-input-focus) (lambda (&rest _) (ert-fail "Focused frame"))))
      (nelisp-calc)
      (should (equal (car (plist-get captured :command)) "C:/shell directory/pwsh.exe"))
      (should (member (expand-file-name "tools/emacs-launch.ps1" nelisp-calc-project-root) (plist-get captured :command)))
      (should (equal (car (last (plist-get captured :command))) "-Activate"))
      (should (member (file-name-as-directory (expand-file-name nelisp-calc-project-root)) (plist-get captured :command)))
      (should (plist-get captured :noquery))
      (should-not hidden))))

(ert-deftest nelisp-calc-repeated-call ()
  (let ((nelisp-calc--process 'existing) captured)
    (cl-letf (((symbol-function 'processp) (lambda (_) t))
              ((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'executable-find) (lambda (_) "powershell.exe"))
              ((symbol-function 'file-regular-p) (lambda (_) t))
              ((symbol-function 'make-process) (lambda (&rest args) (setq captured args) 'activation)))
      (should (eq (nelisp-calc) 'existing))
      (should (member "-Activate" (plist-get captured :command)))
      (should-not (member "-Mode" (plist-get captured :command)))
      (should (equal (buffer-name (plist-get captured :buffer)) " *NeLisp Calc activation*")))))

(ert-deftest nelisp-calc-finished-owner-replaced ()
  (let ((nelisp-calc--process 'finished))
    (cl-letf (((symbol-function 'processp) (lambda (_) t))
              ((symbol-function 'process-live-p) (lambda (_) nil))
              ((symbol-function 'executable-find) (lambda (_) "powershell.exe"))
              ((symbol-function 'file-regular-p) (lambda (_) t))
              ((symbol-function 'make-process) (lambda (&rest _) 'new-owner)))
      (should (eq (nelisp-calc) 'new-owner)))))

(ert-deftest nelisp-calc-live-owner-request-error-preserves-owner ()
  (let ((nelisp-calc--process 'existing))
    (cl-letf (((symbol-function 'processp) (lambda (_) t))
              ((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'executable-find) (lambda (_) "powershell.exe"))
              ((symbol-function 'file-regular-p) (lambda (_) t))
              ((symbol-function 'make-process) (lambda (&rest _) (error "Activation failed"))))
      (should-error (nelisp-calc) :type 'user-error)
      (should (eq nelisp-calc--process 'existing)))))

(ert-deftest nelisp-calc-missing-helper-fails ()
  (let ((nelisp-calc-project-root nelisp-calc-test--root) (nelisp-calc--process nil))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "powershell.exe"))
              ((symbol-function 'file-regular-p) (lambda (_) nil)))
      (should-error (nelisp-calc) :type 'user-error))))

(ert-deftest nelisp-calc-start-error-visible ()
  (let ((nelisp-calc-project-root nelisp-calc-test--root) (nelisp-calc--process nil))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "powershell.exe"))
              ((symbol-function 'make-process) (lambda (&rest _) (error "Owned test failure"))))
      (should-error (nelisp-calc) :type 'user-error)
      (with-current-buffer " *NeLisp Calc launcher*"
        (should (string-match-p "Owned test failure" (buffer-string)))))))

(ert-deftest nelisp-calc-no-shell-fails ()
  (let ((nelisp-calc-project-root nelisp-calc-test--root) (nelisp-calc--process nil))
    (cl-letf (((symbol-function 'executable-find) (lambda (_) nil)))
      (should-error (nelisp-calc) :type 'user-error))))

(ert-run-tests-batch-and-exit)
