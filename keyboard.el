;;; keyboard.el --- Native key routing generator -*- lexical-binding: t; -*-
(defun calc-keyboard-controls (program)
  "Generate one-action key dispatch and observable native signal probes."
  (let (forms (index 0))
    (cl-labels
        ((dispatch (rows)
           (let ((tail 0))
             (dolist (row (reverse rows))
               (let ((id (intern (format "shortcut_%d" (cl-incf index)))))
                 (let ((mode (string-prefix-p "mode:" (cadr row))))
                   (push `(data-blob ,id ,(concat (cadr row) (if mode "\0" "\n\0")) rodata) forms)
                   (setq tail `(if ,(car row) (seq ,@(unless mode '((if (= (shortcut_editable_focus ctx) 1) 0 (extern-call gtk_widget_grab_focus (ptr-read-u64 ctx 8))))) (,(if mode 'emit_command 'send_command) ctx (data-addr ,id)) 1) ,tail)))))
             tail))
         (key (value) `(= keyval ,value))
         (letter (value) `(and (= (logand state 1) 0) (or (= keyval ,value) (= keyval ,(- value 32))))))
      (let* ((memory (dispatch (cl-loop for (code token) in '((109 "memory:store") (112 "memory:add") (113 "memory:sub") (114 "memory:recall") (108 "memory:clear")) collect (list (letter code) token))))
             (modes (dispatch (cl-loop for (code token) in '((49 "mode:standard") (50 "mode:scientific") (51 "mode:programmer") (52 "mode:date") (53 "mode:graph")) collect (list (key code) token))))
             (graph (dispatch (list (list (key 65451) "graph:nav:in") (list (key 65453) "graph:nav:out"))))
             (scientific (dispatch (append
                                   (cl-loop for (code token) in '((65472 "angle:deg") (65473 "angle:rad") (33 "function:factorial") (94 "power")) collect (list (key code) token))
                                   (cl-loop for (code token) in '((108 "function:log") (110 "function:ln") (111 "function:cos") (113 "function:square") (115 "function:sin") (116 "function:tan")) collect (list (letter code) token)))))
             (programmer (dispatch (append
                                   (cl-loop for (code token) in '((65471 "prog:word:32") (65472 "prog:word:16") (65473 "prog:word:8") (65474 "prog:base:hex") (65475 "prog:base:dec") (65476 "prog:base:oct") (65477 "prog:base:bin") (65481 "prog:word:64") (60 "prog:shl") (62 "prog:shr") (124 "prog:or") (126 "prog:not") (38 "prog:and")) collect (list (key code) token))
                                   (cl-loop for code from 97 to 102 collect (list (letter code) (upcase (char-to-string code)))))))
             (ordinary (dispatch (append
                                 (cl-loop for code from 48 to 57 append (list (list (key code) (char-to-string code)) (list (key (+ 65456 (- code 48))) (char-to-string code))))
                                 (cl-loop for (code token) in '((43 "add") (45 "sub") (42 "mul") (47 "div") (46 "dot") (61 "equals") (65293 "equals") (65421 "equals") (65451 "add") (65453 "sub") (65450 "mul") (65455 "div") (65454 "dot") (65452 "dot") (65307 "clear") (65535 "ce") (65439 "ce") (65288 "backspace") (65478 "sign") (37 "percent") (64 "function:sqrt")) collect (list (key code) token))
                                 (list (list (letter 114) "function:reciprocal"))))))
        (push `(defun on_global_key (controller keyval keycode state ctx)
                 (let ((modifiers (logand state 469762061)))
                   (if (= modifiers 8) ,modes
                     (if (= modifiers 4)
                       (if (and (= (ptr-read-u64 ctx 3120) 5) (or (= keyval 65451) (= keyval 65453))) ,graph
                         (if (and (= (ptr-read-u64 ctx 3120) 1) ,(letter 110))
                           (seq (send_command ctx (data-addr shortcut_exp)) 1) ,memory))
                       0)))) forms)
        (push `(defun on_key (controller keyval keycode state ctx)
                       (if (/= (logand state 469762060) 0) 0
                         (if (= (shortcut_editable_focus ctx) 1) 0
                          (if (and (or (= keyval 65293) (= keyval 65421)) (= (shortcut_area_focus ctx) 0)) 0
                          (if (and (> (ptr-read-u64 ctx 3120) 1) (or ,(letter 114) (= keyval 64) (= keyval 37))) 0
                           (let ((special (if (= (ptr-read-u64 ctx 3120) 1) ,scientific
                                            (if (= (ptr-read-u64 ctx 3120) 2) ,programmer 0))))
                             (if (= special 1) 1 ,ordinary))))))) forms)
        (push '(defun shortcut_area_focus (ctx)
                 (let ((focus (extern-call gtk_window_get_focus (ptr-read-u64 ctx 3288))))
                   (if (= focus 0) 0
                     (if (= focus (ptr-read-u64 ctx 8)) 1
                       (extern-call gtk_widget_is_ancestor focus (ptr-read-u64 ctx 8)))))) forms)
        (push '(data-blob calculation_focus_command "ui:calc-focus\0" rodata) forms)
        (push '(data-blob calculation_focus_file "calculation-focus.tsv\0" rodata) forms)
        (push '(data-blob calculation_focus_format "%ld\t%ld\t%ld\n\0" rodata) forms)
        (push '(defun shortcut_editable_focus (ctx)
                 (let ((focus (extern-call gtk_window_get_focus (ptr-read-u64 ctx 3288))))
                   (if (= focus 0) 0
                     (if (/= (extern-call g_type_check_instance_is_a focus (extern-call gtk_editable_get_type)) 0) 1 0)))) forms)
        (push '(data-blob shortcut_exp "function:exp\n\0" rodata) forms)
        (push '(data-blob shortcut_prefix "ui:key:\0" rodata) forms)
        (push '(data-blob shortcut_focus_entry "ui:focus:entry\0" rodata) forms)
        (push '(data-blob shortcut_focus_area "ui:focus:area\0" rodata) forms)
        (push '(data-blob shortcut_entry_prefix "ui:entry:\0" rodata) forms)
        (push '(data-blob shortcut_selection "ui:entry-select\0" rodata) forms)
        (push '(data-blob shortcut_receipts "key-receipts.txt\0" rodata) forms)
        (push '(data-blob shortcut_format "%ld\t%ld\t%ld\t%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%ld\t%ld\t%ld\t%ld\n\0" rodata) forms)
        (push '(defun emit_shortcut_command (ctx command)
                 (if (= (extern-call strcmp command (data-addr calculation_focus_command)) 0)
                   (let ((fp (extern-call fopen (data-addr calculation_focus_file) (data-addr append_mode))))
                     (seq (if (= fp 0) 0 (seq
                       (extern-call fprintf fp (data-addr calculation_focus_format) (shortcut_area_focus ctx)
                         (= (extern-call gtk_window_get_focus (ptr-read-u64 ctx 3288)) (ptr-read-u64 ctx 6544))
                         (ptr-read-u64 ctx 6584)) (extern-call fclose fp))) 1))
                 (if (= (extern-call strncmp command (data-addr shortcut_entry_prefix) 9) 0)
                   (seq (extern-call gtk_editable_set_text (ptr-read-u64 ctx 184) (+ command 9)) 1)
                 (if (= (extern-call strcmp command (data-addr shortcut_selection)) 0)
                   (seq (extern-call gtk_editable_select_region (ptr-read-u64 ctx 184) 1 3) 1)
                 (if (= (extern-call strcmp command (data-addr shortcut_focus_entry)) 0)
                   (seq (extern-call gtk_window_set_focus (ptr-read-u64 ctx 3288) (ptr-read-u64 ctx 184)) 1)
                   (if (= (extern-call strcmp command (data-addr shortcut_focus_area)) 0)
                     (seq (extern-call gtk_window_set_focus (ptr-read-u64 ctx 3288) (ptr-read-u64 ctx 8)) 1)
                     (if (= (extern-call strncmp command (data-addr shortcut_prefix) 7) 0)
                       (let ((key (extern-call strtol (+ command 7) 0 10))
                             (colon (extern-call strchr (+ command 7) 58)))
                         (let ((state (if (= colon 0) 0 (extern-call strtol (+ colon 1) 0 10))))
                           (seq (ptr-write-u64 ctx 128 0)
                             (ptr-write-u64 ctx 3824 0) (ptr-write-u64 ctx 3832 0)
                             (if (= (ptr-read-u64 ctx 3816) 0) 0
                               (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 3816) (data-addr key_pressed) key 0 state (+ ctx 3824)))
                             (if (= (ptr-read-u64 ctx 3824) 1) (ptr-write-u64 ctx 128 1)
                               (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 96) (data-addr key_pressed) key 0 state (+ ctx 3832))
                                    (ptr-write-u64 ctx 128 (ptr-read-u64 ctx 3832))))
                             (let ((fp (extern-call fopen (data-addr shortcut_receipts) (data-addr append_mode))))
                               (if (= fp 0) 0 (seq
                                 (ptr-write-u64 ctx 3800 0) (ptr-write-u64 ctx 3808 0)
                                 (extern-call gtk_editable_get_selection_bounds (ptr-read-u64 ctx 184) (+ ctx 3800) (+ ctx 3808))
                                 (extern-call fprintf fp (data-addr shortcut_format) key state (ptr-read-u64 ctx 128) (extern-call gtk_editable_get_text (ptr-read-u64 ctx 184))
                                   (ptr-read-u64 ctx 3800) (ptr-read-u64 ctx 3808)
                                   (extern-call gtk_event_controller_get_propagation_phase (ptr-read-u64 ctx 96))
                                   (= (extern-call gtk_event_controller_get_widget (ptr-read-u64 ctx 96)) (ptr-read-u64 ctx 3288))
                                   (ptr-read-u64 ctx 3120) (ptr-read-u64 ctx 3824) (ptr-read-u64 ctx 3832)
                                   (if (= (ptr-read-u64 ctx 3816) 0) 0 (extern-call gtk_event_controller_get_propagation_phase (ptr-read-u64 ctx 3816)))
                                   (if (= (ptr-read-u64 ctx 3816) 0) 0 (= (extern-call gtk_event_controller_get_widget (ptr-read-u64 ctx 3816)) (ptr-read-u64 ctx 3288))))
                                 (extern-call fclose fp)))) 1))) 0))))))) forms)
        (append program (nreverse forms))))))
