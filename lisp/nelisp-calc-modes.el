;;; nelisp-calc-modes.el --- Explicit calculator modes -*- lexical-binding: t; -*-

(defvar nelisp-calc-mode 'standard)
(defvar nelisp-calc-prog-base 10)
(defvar nelisp-calc-prog-width 64)
(defvar nelisp-calc-prog-signed nil)
(defvar nelisp-calc-modes-input "0")
(defvar nelisp-calc-prog-left nil)
(defvar nelisp-calc-prog-op nil)
(defvar nelisp-calc-modes-fresh t)

(defun nelisp-calc-modes-decimal-p (value)
  "Accept bounded decimal entry text without evaluating it."
  (and (> (length value) 0) (<= (length value) 128)
       (string-match "\\`[-+]?\\(?:[0-9]+\\(?:\\.[0-9]*\\)?\\|\\.[0-9]+\\)\\(?:[eE][-+]?[0-9]+\\)?\\'" value)))

(defun nelisp-calc-bits-zero () (make-string nelisp-calc-prog-width ?0))
(defun nelisp-calc-bits-add (a b)
  "Add unsigned bit strings modulo the selected word size."
  (let ((r (nelisp-calc-bits-zero)) (carry 0) (i 0))
    (while (< i nelisp-calc-prog-width)
      (let ((n (+ (- (aref a i) ?0) (- (aref b i) ?0) carry)))
        (aset r i (+ ?0 (% n 2))) (setq carry (/ n 2)))
      (setq i (1+ i))) r))
(defun nelisp-calc-bits-not (a)
  (let ((r (copy-sequence a)) (i 0))
    (while (< i (length r)) (aset r i (if (= (aref r i) ?0) ?1 ?0)) (setq i (1+ i))) r))
(defun nelisp-calc-bits-shift (a right rotate)
  (let ((r (nelisp-calc-bits-zero)) (i 0) (w nelisp-calc-prog-width))
    (while (< i w)
      (let ((j (if right (1+ i) (1- i))))
        (when rotate (setq j (% (+ j w) w)))
        (when (and (>= j 0) (< j w)) (aset r i (aref a j))))
      (setq i (1+ i))) r))
(defun nelisp-calc-bits-small (n)
  (let ((r (nelisp-calc-bits-zero)) (i 0))
    (while (and (> n 0) (< i nelisp-calc-prog-width))
      (aset r i (+ ?0 (% n 2))) (setq n (/ n 2) i (1+ i))) r))
(defun nelisp-calc-bits-mul (a b)
  (let ((r (nelisp-calc-bits-zero)) (x a) (i 0))
    (while (< i nelisp-calc-prog-width)
      (when (= (aref b i) ?1) (setq r (nelisp-calc-bits-add r x)))
      (setq x (nelisp-calc-bits-shift x nil nil) i (1+ i))) r))
(defun nelisp-calc-bits-parse-unsigned (s)
  (let ((r (nelisp-calc-bits-zero)) (i 0))
    (while (< i (length s))
      (let* ((c (aref (upcase s) i)) (d (cond ((and (>= c ?0) (<= c ?9)) (- c ?0)) ((and (>= c ?A) (<= c ?F)) (+ 10 (- c ?A))))))
        (unless (and d (< d nelisp-calc-prog-base)) (error "Digit invalid for base"))
        (setq r (nelisp-calc-bits-add
                 (nelisp-calc-bits-mul r (nelisp-calc-bits-small nelisp-calc-prog-base))
                 (nelisp-calc-bits-small d))))
      (setq i (1+ i))) r))
(defun nelisp-calc-bits-parse (s)
  "Parse signed decimal entries as exact two's-complement words."
  (if (string-prefix-p "-" s)
      (progn
        (unless (and nelisp-calc-prog-signed (= nelisp-calc-prog-base 10) (> (length s) 1))
          (error "Negative entry requires signed decimal mode"))
        (nelisp-calc-bits-sub (nelisp-calc-bits-zero) (nelisp-calc-bits-parse-unsigned (substring s 1))))
    (nelisp-calc-bits-parse-unsigned s)))
(defun nelisp-calc-bits-format-unsigned (a)
  "Format without depending on native integer width."
  (let ((digits (list 0)) (i (1- (length a))) (out ""))
    (while (>= i 0)
      (let ((carry (- (aref a i) ?0)) (tail digits))
        (while tail
          (let ((n (+ (* 2 (car tail)) carry)))
            (setcar tail (% n nelisp-calc-prog-base)) (setq carry (/ n nelisp-calc-prog-base)))
          (setq tail (cdr tail)))
        (when (> carry 0) (setq digits (append digits (list carry)))))
      (setq i (1- i)))
    (dolist (d digits) (setq out (concat (char-to-string (aref "0123456789ABCDEF" d)) out))) out))
(defun nelisp-calc-bits-negative-p (a)
  (and nelisp-calc-prog-signed (= (aref a (1- (length a))) ?1)))
(defun nelisp-calc-bits-format (a)
  "Use signed decimal presentation, retaining bit patterns in other bases."
  (if (and (= nelisp-calc-prog-base 10) (nelisp-calc-bits-negative-p a))
      (concat "-" (nelisp-calc-bits-format-unsigned (nelisp-calc-bits-sub (nelisp-calc-bits-zero) a)))
    (nelisp-calc-bits-format-unsigned a)))
(defun nelisp-calc-bits-compare (a b)
  (let ((i (1- (length a))) (result 0))
    (while (and (>= i 0) (= result 0))
      (setq result (- (aref a i) (aref b i)) i (1- i))) result))
(defun nelisp-calc-bits-sub (a b)
  (nelisp-calc-bits-add a (nelisp-calc-bits-add (nelisp-calc-bits-not b) (nelisp-calc-bits-small 1))))
(defun nelisp-calc-bits-div-unsigned (a b)
  (when (equal b (nelisp-calc-bits-zero)) (error "Division by zero"))
  (let ((q (nelisp-calc-bits-zero)) (r (nelisp-calc-bits-zero)) (i (1- nelisp-calc-prog-width)))
    (while (>= i 0)
      (setq r (nelisp-calc-bits-shift r nil nil)) (aset r 0 (aref a i))
      (when (>= (nelisp-calc-bits-compare r b) 0)
        (setq r (nelisp-calc-bits-sub r b)) (aset q i ?1))
      (setq i (1- i))) q))
(defun nelisp-calc-bits-div (a b)
  "Divide signed magnitudes with truncation toward zero and word-size wrap."
  (let* ((negative-a (nelisp-calc-bits-negative-p a)) (negative-b (nelisp-calc-bits-negative-p b))
         (zero (nelisp-calc-bits-zero))
         (q (nelisp-calc-bits-div-unsigned
             (if negative-a (nelisp-calc-bits-sub zero a) a)
             (if negative-b (nelisp-calc-bits-sub zero b) b))))
    (if (eq negative-a negative-b) q (nelisp-calc-bits-sub zero q))))
(defun nelisp-calc-bits-binary (a op b)
  (cond ((equal op "+") (nelisp-calc-bits-add a b))
        ((equal op "-") (nelisp-calc-bits-sub a b))
        ((equal op "*") (nelisp-calc-bits-mul a b))
        ((equal op "/") (nelisp-calc-bits-div a b))
        (t (let ((r (nelisp-calc-bits-zero)) (i 0))
             (while (< i nelisp-calc-prog-width)
               (let ((x (= (aref a i) ?1)) (y (= (aref b i) ?1)))
                 (aset r i (if (cond ((equal op "and") (and x y))
                                     ((equal op "or") (or x y))
                                     ((equal op "xor") (not (eq x y)))) ?1 ?0)))
               (setq i (1+ i))) r))))

;; Factors and offsets are exact Calc expressions: canonical = value * factor + offset.
(defconst nelisp-calc-convert-categories
  '((length (m "1" "0") (km "1000" "0") (cm "1/100" "0") (ft "0.3048" "0") (inch "0.0254" "0") (mi "1609.344" "0") (yd "0.9144" "0") (nmi "1852" "0"))
    (volume (l "1" "0") (ml "1/1000" "0") (gal "3.785411784" "0"))
    (area (m2 "1" "0") (ft2 "0.09290304" "0") (ha "10000" "0"))
    (mass (kg "1" "0") (g "1/1000" "0") (lb "0.45359237" "0") (oz "0.028349523125" "0") (tonne "1000" "0"))
    (temp (c "1" "0") (f "5/9" "-160/9") (k "1" "-273.15"))
    (energy (j "1" "0") (kj "1000" "0") (kwh "3600000" "0") (cal "4.184" "0"))
    (speed (mps "1" "0") (kph "5/18" "0") (mph "0.44704" "0"))
    (time (s "1" "0") (min "60" "0") (h "3600" "0") (day "86400" "0"))
    (power (w "1" "0") (kw "1000" "0") (hp "745.69987158227022" "0"))
    (data (byte "1" "0") (bit "1/8" "0") (kb "1000" "0") (kib "1024" "0") (gib "1073741824" "0"))
    (pressure (pa "1" "0") (kpa "1000" "0") (bar "100000" "0") (atm "101325" "0") (psi "6894.757293168361" "0") (mmhg "133.322387415" "0"))
    (angle (deg "1" "0") (rad "180/pi" "0") (turn "360" "0"))))
(defvar nelisp-calc-convert-category 'length)
(defvar nelisp-calc-convert-from 'm)
(defvar nelisp-calc-convert-to 'ft)
(defun nelisp-calc-convert ()
  (let* ((units (cdr (assq nelisp-calc-convert-category nelisp-calc-convert-categories)))
         (a (cdr (assq nelisp-calc-convert-from units)))
         (b (cdr (assq nelisp-calc-convert-to units))))
    (unless (and a b) (error "Choose units in the selected category"))
    (let ((result (nelisp-calc-evaluate
                   (format "(((%s)*(%s)+(%s))-(%s))/(%s)"
                           nelisp-calc-modes-input (car a) (cadr a) (cadr b) (car b)))))
      (unless (plist-get result :ok) (error "%s" (plist-get result :error)))
      (setq nelisp-calc-display (plist-get result :value) nelisp-calc-modes-fresh t))))

(defun nelisp-calc-date-leap (y) (and (= (% y 4) 0) (or (/= (% y 100) 0) (= (% y 400) 0))))
(defun nelisp-calc-date-days (y m)
  (if (= m 2) (if (nelisp-calc-date-leap y) 29 28) (if (memq m '(4 6 9 11)) 30 31)))
(defun nelisp-calc-date-ordinal (s)
  (unless (string-match "\\`\\([0-9][0-9][0-9][0-9]\\)-\\([0-9][0-9]\\)-\\([0-9][0-9]\\)\\'" s) (error "Use YYYY-MM-DD"))
  (let* ((y (string-to-number (match-string 1 s))) (m (string-to-number (match-string 2 s)))
         (d (string-to-number (match-string 3 s))) (n (1- y)) (i 1))
    (unless (and (>= y 1) (<= y 9999) (>= m 1) (<= m 12) (>= d 1) (<= d (nelisp-calc-date-days y m))) (error "Invalid Gregorian date"))
    (setq n (+ (* n 365) (/ n 4) (- (/ n 100)) (/ n 400) d))
    (while (< i m) (setq n (+ n (nelisp-calc-date-days y i)) i (1+ i))) n))
(defun nelisp-calc-date-format (n)
  (unless (and (>= n 1) (<= n 3652059)) (error "Date outside years 0001..9999"))
  (let ((y 1) (m 1))
    (while (> n (if (nelisp-calc-date-leap y) 366 365))
      (setq n (- n (if (nelisp-calc-date-leap y) 366 365)) y (1+ y)))
    (while (> n (nelisp-calc-date-days y m)) (setq n (- n (nelisp-calc-date-days y m)) m (1+ m)))
    (format "%04d-%02d-%02d" y m n)))

;;;###autoload
(defun nelisp-calc-modes-token (token)
  "Handle explicit modes, returning nil for other modes.
Programmer arithmetic is unsigned, fixed width and wraps modulo 2^width.
Shifts are logical one-bit operations; rotations preserve the word width."
  (setq token (or (cdr (assoc token '(("add" . "+") ("sub" . "-") ("mul" . "*") ("div" . "/") ("equals" . "=") ("dot" . ".")))) token))
  (if (not (or (member token '("mode:programmer" "mode:convert" "mode:date"))
               (memq nelisp-calc-mode '(programmer convert date)))) nil
    (condition-case err
        (progn
          (cond
           ((member token '("mode:programmer" "mode:convert" "mode:date"))
            (setq nelisp-calc-mode (intern (substring token 5)) nelisp-calc-modes-input "0"
                  nelisp-calc-display "0" nelisp-calc-prog-left nil nelisp-calc-prog-op nil nelisp-calc-modes-fresh t))
           ((string-match "\\`mode:" token) nil)
           ((and (eq nelisp-calc-mode 'programmer) (string-prefix-p "prog:input:" token))
            (let ((entry (substring token 11)))
              (unless (and (> (length entry) 0) (<= (length entry) 128)) (error "Programmer input length invalid"))
              (setq nelisp-calc-modes-input (nelisp-calc-bits-format (nelisp-calc-bits-parse entry))
                    nelisp-calc-display nelisp-calc-modes-input nelisp-calc-modes-fresh nil)))
           ((and (eq nelisp-calc-mode 'convert) (string-prefix-p "convert:input:" token))
            (let ((entry (substring token 14)))
              (unless (nelisp-calc-modes-decimal-p entry) (error "Converter input must be decimal"))
              (setq nelisp-calc-modes-input entry nelisp-calc-display entry nelisp-calc-modes-fresh nil)))
           ((and (eq nelisp-calc-mode 'programmer) (member token '("prog:signed" "prog:unsigned")))
            (let ((bits (nelisp-calc-bits-parse nelisp-calc-modes-input)))
              (setq nelisp-calc-prog-signed (equal token "prog:signed")
                    nelisp-calc-modes-input (nelisp-calc-bits-format bits) nelisp-calc-display nelisp-calc-modes-input)))
           ((and (eq nelisp-calc-mode 'programmer) (string-match "\\`prog:base:\\(hex\\|dec\\|oct\\|bin\\)\\'" token))
            (let ((bits (nelisp-calc-bits-parse nelisp-calc-modes-input)) (base (match-string 1 token)))
              (setq nelisp-calc-prog-base (cdr (assoc base '(("hex" . 16) ("dec" . 10) ("oct" . 8) ("bin" . 2))))
                    nelisp-calc-modes-input (nelisp-calc-bits-format bits) nelisp-calc-display nelisp-calc-modes-input)))
           ((and (eq nelisp-calc-mode 'programmer) (string-match "\\`prog:word:\\(8\\|16\\|32\\|64\\)\\'" token))
            (let ((bits (nelisp-calc-bits-parse nelisp-calc-modes-input)) (w (string-to-number (match-string 1 token))))
              (setq nelisp-calc-prog-width w nelisp-calc-prog-left nil nelisp-calc-prog-op nil
                    nelisp-calc-modes-input (nelisp-calc-bits-format (substring (concat bits (make-string 64 (if (nelisp-calc-bits-negative-p bits) ?1 ?0))) 0 w))
                    nelisp-calc-display nelisp-calc-modes-input)))
           ((and (eq nelisp-calc-mode 'programmer) (member token '("prog:not" "prog:shl" "prog:shr" "prog:rol" "prog:ror")))
            (let* ((a (nelisp-calc-bits-parse nelisp-calc-modes-input))
                   (r (if (equal token "prog:not") (nelisp-calc-bits-not a)
                        (nelisp-calc-bits-shift a (member token '("prog:shr" "prog:ror")) (member token '("prog:rol" "prog:ror"))))))
              (when (and (equal token "prog:shr") (nelisp-calc-bits-negative-p a))
                (aset r (1- nelisp-calc-prog-width) ?1))
              (setq nelisp-calc-modes-input (nelisp-calc-bits-format r) nelisp-calc-display nelisp-calc-modes-input nelisp-calc-modes-fresh t)))
           ((and (eq nelisp-calc-mode 'programmer) (equal token "sign"))
            (unless (and nelisp-calc-prog-signed (= nelisp-calc-prog-base 10)) (error "Sign requires signed decimal mode"))
            (setq nelisp-calc-modes-input (if (string-prefix-p "-" nelisp-calc-modes-input) (substring nelisp-calc-modes-input 1) (concat "-" nelisp-calc-modes-input))
                  nelisp-calc-display nelisp-calc-modes-input nelisp-calc-modes-fresh nil))
           ((and (eq nelisp-calc-mode 'programmer) (member token '("+" "-" "*" "/" "prog:and" "prog:or" "prog:xor")))
            (setq nelisp-calc-prog-left (nelisp-calc-bits-parse nelisp-calc-modes-input)
                  nelisp-calc-prog-op (if (string-match "prog:" token) (substring token 5) token) nelisp-calc-modes-fresh t))
           ((and (eq nelisp-calc-mode 'convert) (string-match "\\`convert:\\(category\\|from\\|to\\):\\([a-z0-9]+\\)\\'" token))
            (let ((kind (match-string 1 token)) (value (intern (match-string 2 token))))
              (cond ((equal kind "category")
                     (let ((units (cdr (assq value nelisp-calc-convert-categories))))
                       (unless units (error "Unknown category"))
                       (setq nelisp-calc-convert-category value nelisp-calc-convert-from (caar units) nelisp-calc-convert-to (car (cadr units)))))
                    ((equal kind "from") (setq nelisp-calc-convert-from value))
                    (t (setq nelisp-calc-convert-to value)))))
           ((and (eq nelisp-calc-mode 'date) (string-match "\\`date:diff:\\([^:]+\\):\\([^:]+\\)\\'" token))
            (let ((a (match-string 1 token)) (b (match-string 2 token)))
              (setq nelisp-calc-display (number-to-string (- (nelisp-calc-date-ordinal b) (nelisp-calc-date-ordinal a))))))
           ((and (eq nelisp-calc-mode 'date) (string-match "\\`date:add:\\([^:]+\\):\\(-?[0-9]+\\)\\'" token))
            (let ((a (match-string 1 token)) (b (match-string 2 token)))
              (when (> (length b) 8) (error "Day offset too large"))
              (setq nelisp-calc-display (nelisp-calc-date-format (+ (nelisp-calc-date-ordinal a) (string-to-number b))))))
           ((member token '("clear" "C" "CE"))
            (setq nelisp-calc-modes-input "0" nelisp-calc-display "0" nelisp-calc-prog-left nil nelisp-calc-prog-op nil nelisp-calc-modes-fresh t))
           ((member token '("backspace" "BS"))
            (setq nelisp-calc-modes-input (if (> (length nelisp-calc-modes-input) 1) (substring nelisp-calc-modes-input 0 -1) "0") nelisp-calc-display nelisp-calc-modes-input))
           ((member token '("=" "equals"))
            (cond ((eq nelisp-calc-mode 'convert) (nelisp-calc-convert))
                  ((and (eq nelisp-calc-mode 'programmer) nelisp-calc-prog-left)
                   (setq nelisp-calc-modes-input (nelisp-calc-bits-format (nelisp-calc-bits-binary nelisp-calc-prog-left nelisp-calc-prog-op (nelisp-calc-bits-parse nelisp-calc-modes-input)))
                         nelisp-calc-display nelisp-calc-modes-input nelisp-calc-prog-left nil nelisp-calc-modes-fresh t))
                  ((eq nelisp-calc-mode 'date) (error "Use date:add:YYYY-MM-DD:days or date:diff:YYYY-MM-DD:YYYY-MM-DD"))))
           ((string-match "\\`[0-9a-fA-F.]\\'" token)
            (let ((s (if nelisp-calc-modes-fresh token (concat nelisp-calc-modes-input token))))
              (when (eq nelisp-calc-mode 'programmer) (nelisp-calc-bits-parse s))
              (setq nelisp-calc-modes-input s nelisp-calc-display s nelisp-calc-modes-fresh nil)))
           ((and (eq nelisp-calc-mode 'convert) (equal token "sign"))
            (setq nelisp-calc-modes-input (if (string-prefix-p "-" nelisp-calc-modes-input) (substring nelisp-calc-modes-input 1) (concat "-" nelisp-calc-modes-input)) nelisp-calc-display nelisp-calc-modes-input))
           (t (error "Unsupported mode token: %s" token)))
          (setq nelisp-calc-status (cond ((eq nelisp-calc-mode 'programmer) (format "programmer:%s:%d-bit:base-%d" (if nelisp-calc-prog-signed "signed" "unsigned") nelisp-calc-prog-width nelisp-calc-prog-base))
                                       ((eq nelisp-calc-mode 'convert) (format "convert:%s:%s:%s" nelisp-calc-convert-category nelisp-calc-convert-from nelisp-calc-convert-to))
                                       (t "date:date:add:YYYY-MM-DD:days or date:diff:YYYY-MM-DD:YYYY-MM-DD"))))
      (error (setq nelisp-calc-display "ERROR" nelisp-calc-status (concat "mode-error:" (error-message-string err)) nelisp-calc-modes-fresh t)))
    (not (and (string-match "\\`mode:" token) (not (member token '("mode:programmer" "mode:convert" "mode:date")))))))

(provide 'nelisp-calc-modes)
