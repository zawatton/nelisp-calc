;;; nelisp-calc-graph.el --- Calc graph and ECB currency modes -*- lexical-binding: t; -*-

(defvar nelisp-calc-graph-expression "x^2")
(defvar nelisp-calc-graph-range '("-10" "10" "-10" "10"))
(defvar nelisp-calc-graph-samples 101)
(defvar nelisp-calc-graph-last-error nil)
(defvar nelisp-calc-currency-from "EUR")
(defvar nelisp-calc-currency-to "USD")
(defvar nelisp-calc-currency-input "0")
(defvar nelisp-calc-currency-fresh t)
(defvar nelisp-calc-currency-max-age 7)

(defun nelisp-calc-graph-target ()
  (expand-file-name "graph.txt" (or (getenv "NELISP_CALC_TARGET")
                                   (expand-file-name "target" nelisp-calc-root))))
(defun nelisp-calc-graph-write (text)
  "Publish complete ASCII graph data using an atomic rename."
  (let* ((path (nelisp-calc-graph-target)) (temporary (concat path ".tmp")))
    (make-directory (file-name-directory path) t)
    (let ((coding-system-for-write 'us-ascii))
      (with-temp-file temporary (insert text)))
    (rename-file temporary path t)))
(defun nelisp-calc-graph-number (expression)
  "Return a finite decimal from genuine Calc, or raise its visible error."
  (let* ((result (nelisp-calc-evaluate expression)) (value (plist-get result :value)))
    (unless (plist-get result :ok) (error "Calc: %s" (plist-get result :error)))
    (unless (and (stringp value)
                 (string-match "\\`[-+]?[0-9]+\\(?:\\.[0-9]*\\)?\\(?:[eE][-+]?[0-9]+\\)?\\'" value))
      (error "Calc returned a non-decimal value: %s" value))
    value))
(defun nelisp-calc-graph-substitute (expression x)
  "Replace the complete variable x, retaining function and identifier names."
  (let ((i 0) (out ""))
    (while (< i (length expression))
      (let ((before (and (> i 0) (substring expression (1- i) i)))
            (after (and (< (1+ i) (length expression)) (substring expression (1+ i) (+ i 2)))))
        (setq out (concat out (if (and (= (aref expression i) ?x)
                                      (not (and before (string-match "[A-Za-z0-9_]" before)))
                                      (not (and after (string-match "[A-Za-z0-9_]" after))))
                                 (concat "(" x ")") (substring expression i (1+ i))))))
      (setq i (1+ i))) out))
(defun nelisp-calc-graph-literal (value)
  "Format viewport values despite the standalone negative %g defect."
  (if (< value 0) (concat "-" (format "%.12g" (- value))) (format "%.12g" value)))
(defun nelisp-calc-graph-validate-range (range)
  "Validate bounded decimal viewport geometry before sampling or committing."
  (unless (= (length range) 4) (error "Range needs four bounds"))
  (let (values)
    (dolist (bound range)
      (unless (and (stringp bound) (<= (length bound) 32)
                   (string-match "\\`[-+]?[0-9]+\\(?:\\.[0-9]*\\)?\\(?:[eE]\\([-+]?[0-9]\\{1,3\\}\\)\\)?\\'" bound))
        (error "Graph bounds must be finite decimal literals"))
      (let ((exponent (match-string 1 bound)))
        (when (and exponent (> (abs (string-to-number exponent)) 50))
          (error "Graph bound exponent exceeds supported precision")))
      (let ((value (float (string-to-number bound))))
        (unless (and (<= (abs value) 1.0e50)
                     (or (= value 0) (>= (abs value) 1.0e-50)))
          (error "Graph bound magnitude exceeds supported precision"))
        (setq values (append values (list value)))))
    (dolist (pair (list (list (nth 0 values) (nth 1 values))
                        (list (nth 2 values) (nth 3 values))))
      (let ((span (- (cadr pair) (car pair))))
        (unless (and (>= span 1.0e-20) (<= span 1.0e50)
                     (< (string-to-number (nelisp-calc-graph-literal (car pair)))
                        (string-to-number (nelisp-calc-graph-literal (cadr pair)))))
          (error "Graph ranges must increase without precision collapse"))))
    values))
(defun nelisp-calc-graph-publish-range ()
  "Atomically publish the accepted range for native field synchronization."
  (let* ((path (expand-file-name "graph-range.txt" (file-name-directory (nelisp-calc-graph-target))))
         (temporary (concat path ".tmp")))
    (make-directory (file-name-directory path) t)
    (with-temp-file temporary (insert (mapconcat #'identity nelisp-calc-graph-range ":")))
    (rename-file temporary path t)))
(defun nelisp-calc-graph-navigate (action)
  "Render a candidate viewport, then commit its range on success."
  (let* ((values (nelisp-calc-graph-validate-range nelisp-calc-graph-range))
         (xmin (nth 0 values)) (xmax (nth 1 values))
         (ymin (nth 2 values)) (ymax (nth 3 values))
         (xd (- xmax xmin)) (yd (- ymax ymin)) candidate)
    (cond ((equal action "reset") (setq candidate '("-10" "10" "-10" "10")))
          ((member action '("in" "out"))
           (let* ((factor (if (equal action "in") 0.25 1.0))
                  (xc (+ xmin (/ xd 2.0))) (yc (+ ymin (/ yd 2.0)))
                  (xh (* xd factor)) (yh (* yd factor)))
             (setq candidate (mapcar #'nelisp-calc-graph-literal
                                     (list (- xc xh) (+ xc xh) (- yc yh) (+ yc yh))))))
          ((member action '("left" "right" "up" "down"))
           (let ((dx (cond ((equal action "left") (- (/ xd 4.0)))
                           ((equal action "right") (/ xd 4.0)) (t 0)))
                 (dy (cond ((equal action "down") (- (/ yd 4.0)))
                           ((equal action "up") (/ yd 4.0)) (t 0))))
             (setq candidate (mapcar #'nelisp-calc-graph-literal
                                     (list (+ xmin dx) (+ xmax dx) (+ ymin dy) (+ ymax dy))))))
          (t (error "Unknown graph navigation action")))
    (nelisp-calc-graph-accept candidate nelisp-calc-graph-expression)))
(defun nelisp-calc-graph-transform (token)
  "Apply one bounded integer gesture to the canonical accepted viewport."
  (let* ((values (nelisp-calc-graph-validate-range nelisp-calc-graph-range))
         (xmin (nth 0 values)) (xmax (nth 1 values))
         (ymin (nth 2 values)) (ymax (nth 3 values))
         (xd (- xmax xmin)) (yd (- ymax ymin)) candidate)
    (cond
     ((string-match "\\`graph:shift:\\(-?[0-9]\\{1,4\\}\\):\\(-?[0-9]\\{1,4\\}\\)\\'" token)
      (let ((dx (string-to-number (match-string 1 token)))
            (dy (string-to-number (match-string 2 token))))
        (unless (and (<= (abs dx) 2000) (<= (abs dy) 2000))
          (error "Graph shift exceeds 2000 permille"))
        (when (and (= dx 0) (= dy 0)) (error "Graph shift needs motion"))
        (setq dx (* xd (/ dx 1000.0)) dy (* yd (/ dy 1000.0)))
        (setq candidate (list (+ xmin dx) (+ xmax dx) (+ ymin dy) (+ ymax dy)))))
     ((string-match "\\`graph:zoom:\\(-?[0-9]\\)\\'" token)
      (let ((steps (string-to-number (match-string 1 token)))
            (factor 0.5))
        (unless (and (/= steps 0) (<= (abs steps) 4))
          (error "Graph zoom needs 1..4 signed steps"))
        (setq factor (expt 2.0 (- steps)))
        (let ((xc (+ xmin (/ xd 2.0))) (yc (+ ymin (/ yd 2.0)))
              (xh (/ (* xd factor) 2.0)) (yh (/ (* yd factor) 2.0)))
          (setq candidate (list (- xc xh) (+ xc xh) (- yc yh) (+ yc yh))))))
     (t (error "Invalid graph gesture token")))
    (nelisp-calc-graph-accept (mapcar #'nelisp-calc-graph-literal candidate)
                            nelisp-calc-graph-expression)))
(defun nelisp-calc-graph-accept (range expression)
  "Commit candidate RANGE and EXPRESSION only after a successful render."
  (let ((accepted-range range) (accepted-expression expression))
    (let ((nelisp-calc-graph-range range) (nelisp-calc-graph-expression expression))
      (nelisp-calc-graph-render))
    (setq nelisp-calc-graph-range accepted-range
          nelisp-calc-graph-expression accepted-expression)))
(defun nelisp-calc-graph-render ()
  "Render an explicit function or a bounded implicit Calc contour."
  (if (and (string-match "\\`[ \t]*y[ \t]*=[ \t]*\\([^=]+\\)\\'" nelisp-calc-graph-expression)
           (not (string-match "\\_<y\\_>" (match-string 1 nelisp-calc-graph-expression))))
      (let ((nelisp-calc-graph-expression (cadr (split-string nelisp-calc-graph-expression "="))))
        (nelisp-calc-graph-render-explicit))
    (let ((residual (nelisp-calc-implicit-expression nelisp-calc-graph-expression)))
      (if residual (nelisp-calc-implicit-render residual)
        (nelisp-calc-graph-render-explicit)))))
(defun nelisp-calc-graph-render-explicit ()
  "Sample a real Calc expression and publish clipped, segmented plot points."
  (setq nelisp-calc-graph-last-error nil)
  (unless (and (integerp nelisp-calc-graph-samples) (>= nelisp-calc-graph-samples 64)
               (<= nelisp-calc-graph-samples 257)) (error "Graph samples must be 64..257"))
  (nelisp-calc-graph-validate-range nelisp-calc-graph-range)
  ;; Native floating point is used only for viewport geometry. Every sampled
  ;; user expression still goes through the genuine GNU Calc adapter.
  (let* ((xmin (float (string-to-number (nth 0 nelisp-calc-graph-range))))
         (xmax (float (string-to-number (nth 1 nelisp-calc-graph-range))))
         (ymin (float (string-to-number (nth 2 nelisp-calc-graph-range))))
         (ymax (float (string-to-number (nth 3 nelisp-calc-graph-range))))
         (xd (- xmax xmin)) (yd (- ymax ymin))
         (count 0) (i 0) (previous nil) (lines "SCG1\n"))
    (unless (and (> xd 0) (> yd 0) (< xd 1.0e100) (< yd 1.0e100))
      (error "Graph ranges must increase"))
    (while (< i nelisp-calc-graph-samples)
      (condition-case sample-error
          (let* ((fraction (/ (float i) (1- nelisp-calc-graph-samples)))
                 (x (nelisp-calc-graph-literal (+ xmin (* xd fraction))))
                 (expression (nelisp-calc-graph-substitute nelisp-calc-graph-expression x))
                 (y (string-to-number (nelisp-calc-graph-number expression)))
                 (px (* 1000 fraction)) (py (/ (* 1000 (- ymax y)) yd)))
            (if (or (< py 0) (> py 1000))
                (setq lines (concat lines "0 0 0\n") previous nil)
              ;; A jump larger than half the viewport is a conservative break.
              (when (and previous (> (abs (- py previous)) 500))
                (setq lines (concat lines "0 0 0\n")))
              (setq lines (concat lines (format "1 %d %d\n" (round px) (round py)))
                    previous py count (1+ count))))
        (error (setq lines (concat lines "0 0 0\n") previous nil
                     nelisp-calc-graph-last-error (error-message-string sample-error))
               ;; A missing runtime capability is not an undefined graph point.
               (when (string-match "nelisp-\\|void-function\\|file-missing\\|Calc number expected: ([A-Za-z_]" nelisp-calc-graph-last-error)
                 (error "%s" nelisp-calc-graph-last-error))))
      (setq i (1+ i)))
    (unless (> count 0) (error "No valid Calc samples in viewport: %s" nelisp-calc-graph-last-error))
    (nelisp-calc-graph-write lines)
    (setq nelisp-calc-display (format "%d points" count)
          nelisp-calc-status (format "ok:graph:%s:%d/%d" nelisp-calc-graph-expression count nelisp-calc-graph-samples))))

(defun nelisp-calc-currency-path ()
  (or (getenv "NELISP_CALC_RATES") (expand-file-name "target/currency-rates.tsv" nelisp-calc-root)))
(defun nelisp-calc-currency-today ()
  "Use the launcher clock when the standalone runtime has no real clock."
  (let ((today (or (getenv "NELISP_CALC_TODAY") (format-time-string "%Y-%m-%d"))))
    (nelisp-calc-date-ordinal today) today))
(defun nelisp-calc-currency-read ()
  "Read a validated EUR-relative ECB cache; never invent missing rates."
  (let ((path (nelisp-calc-currency-path)) (rates nil) (date nil))
    (unless (file-exists-p path) (error "ECB cache missing; run tools/update-rates.ps1"))
    (when (> (file-attribute-size (file-attributes path)) 65536) (error "ECB cache too large"))
    (with-temp-buffer
      (insert-file-contents path)
      (let ((lines (split-string (buffer-string) "\n" t)))
        (unless (string-match "\\`date=\\([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\\)\\'" (car lines)) (error "Invalid ECB cache date"))
        (setq date (match-string 1 (car lines)))
        (nelisp-calc-date-ordinal date)
        (dolist (line (cdr lines))
          (unless (string-match "\\`\\([A-Z][A-Z][A-Z]\\)\t\\([0-9]+\\(?:\\.[0-9]+\\)?\\)\\'" line) (error "Invalid ECB rate row"))
          (let ((code (match-string 1 line)) (rate (match-string 2 line)))
            (when (or (assoc code rates) (<= (string-to-number rate) 0) (> (length rate) 24)) (error "Invalid or duplicate ECB rate"))
            (setq rates (cons (cons code rate) rates))))))
    (unless (equal (cdr (assoc "EUR" rates)) "1") (error "ECB base must be EUR=1"))
    (let* ((today (nelisp-calc-currency-today))
           (age (- (nelisp-calc-date-ordinal today) (nelisp-calc-date-ordinal date))))
      (when (< age 0) (error "ECB cache date is in the future"))
      (list date rates age))))
(defun nelisp-calc-currency-convert ()
  (let* ((cache (nelisp-calc-currency-read)) (date (car cache)) (rates (cadr cache)) (age (nth 2 cache))
         (from (cdr (assoc nelisp-calc-currency-from rates)))
         (to (cdr (assoc nelisp-calc-currency-to rates))))
    (unless (and from to) (error "Currency absent from ECB cache"))
    (setq nelisp-calc-display (nelisp-calc-graph-number (format "(%s)*(%s)/(%s)" nelisp-calc-currency-input to from))
          nelisp-calc-currency-fresh t
          nelisp-calc-status (format "%s:currency:ECB:%s:%s/%s"
                                    (if (> age nelisp-calc-currency-max-age) "stale" "ok") date nelisp-calc-currency-from nelisp-calc-currency-to))))

;;;###autoload
(defun nelisp-calc-graph-token (token)
  "Handle graph and currency tokens, exposing provider errors in the UI."
  (setq token (or (cdr (assoc token '(("add" . "+") ("sub" . "-") ("mul" . "*") ("div" . "/") ("equals" . "=") ("dot" . ".")))) token))
  (if (or (member token '("mode:graph" "mode:currency"))
          (and (memq nelisp-calc-mode '(graph currency)) (not (string-prefix-p "mode:" token))))
      (progn
        (condition-case err
            (cond
             ((equal token "mode:graph")
              (setq nelisp-calc-mode 'graph nelisp-calc-display "x^2"
                    nelisp-calc-status "graph:use graph:expression and graph:range:xmin:xmax:ymin:ymax"))
             ((equal token "mode:currency")
              (setq nelisp-calc-mode 'currency nelisp-calc-currency-input "0" nelisp-calc-display "0" nelisp-calc-currency-fresh t)
              (let ((cache (nelisp-calc-currency-read)))
                (setq nelisp-calc-status (format "%s:currency:ECB:%s" (if (> (nth 2 cache) nelisp-calc-currency-max-age) "stale" "ready") (car cache)))))
             ((eq nelisp-calc-mode 'graph)
              (cond ((string-prefix-p "graph:range:" token)
                     (let ((parts (split-string (substring token 12) ":")))
                       (unless (= (length parts) 4) (error "Range needs xmin:xmax:ymin:ymax"))
                       (nelisp-calc-graph-accept parts nelisp-calc-graph-expression)))
                    ((string-prefix-p "graph:nav:" token)
                     (nelisp-calc-graph-navigate (substring token 10)))
                    ((or (string-prefix-p "graph:shift:" token)
                         (string-prefix-p "graph:zoom:" token))
                     (nelisp-calc-graph-transform token))
                    ((or (string-prefix-p "graph:" token) (string-prefix-p "eval:" token))
                     (let ((expression (substring token (if (string-prefix-p "graph:" token) 6 5))))
                       (when (> (length expression) 256) (error "Graph expression too long"))
                       (nelisp-calc-graph-accept nelisp-calc-graph-range expression)))
                    ((member token '("=" "equals")) (nelisp-calc-graph-render))
                    ((member token '("clear" "C" "CE")) (nelisp-calc-graph-write "SCG1\n") (setq nelisp-calc-display "0" nelisp-calc-status "graph:cleared"))
                    (t (error "Use graph:expression"))))
             ((string-prefix-p "currency:input:" token)
              (let ((entry (substring token 15)))
                (unless (nelisp-calc-modes-decimal-p entry) (error "Currency input must be decimal"))
                (setq nelisp-calc-currency-input entry nelisp-calc-display entry nelisp-calc-currency-fresh nil
                      nelisp-calc-status "currency:editing")))
             ((string-match "\\`currency:\\(from\\|to\\):\\([A-Z][A-Z][A-Z]\\)\\'" token)
              (let ((kind (match-string 1 token)) (code (match-string 2 token)))
                (unless (assoc code (cadr (nelisp-calc-currency-read))) (error "Currency absent from ECB cache"))
                (if (equal kind "from") (setq nelisp-calc-currency-from code) (setq nelisp-calc-currency-to code)))
              (setq nelisp-calc-status "currency:press equals"))
             ((member token '("=" "equals")) (nelisp-calc-currency-convert))
             ((member token '("clear" "C" "CE")) (setq nelisp-calc-currency-input "0" nelisp-calc-display "0" nelisp-calc-currency-fresh t nelisp-calc-status "currency:cleared"))
             ((member token '("backspace" "BS"))
              (setq nelisp-calc-currency-input (if (> (length nelisp-calc-currency-input) 1) (substring nelisp-calc-currency-input 0 -1) "0") nelisp-calc-display nelisp-calc-currency-input))
             ((equal token "sign") (setq nelisp-calc-currency-input (if (string-prefix-p "-" nelisp-calc-currency-input) (substring nelisp-calc-currency-input 1) (concat "-" nelisp-calc-currency-input)) nelisp-calc-display nelisp-calc-currency-input))
             ((string-match "\\`[0-9.]\\'" token)
              (setq nelisp-calc-currency-input (if nelisp-calc-currency-fresh token (concat nelisp-calc-currency-input token)) nelisp-calc-display nelisp-calc-currency-input nelisp-calc-currency-fresh nil))
             (t (error "Unsupported currency token")))
          (error (setq nelisp-calc-display "ERROR" nelisp-calc-status (concat "mode-error:" (error-message-string err)))))
        (when (eq nelisp-calc-mode 'graph) (nelisp-calc-graph-publish-range))
        t) nil))

(load (expand-file-name "lisp/nelisp-calc-implicit.el" nelisp-calc-root) nil t)
(provide 'nelisp-calc-graph)
