;;; build.el --- Build the Sumi calculator -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'subr-x)
(setq max-lisp-eval-depth 10000
      max-specpdl-size 20000
      backtrace-on-error-noninteractive nil)
(defconst calc-root (file-name-directory (or load-file-name buffer-file-name)))
(defconst calc-nelisp-root (expand-file-name (or (getenv "NELISP_ROOT") "../nelisp") calc-root))
(defconst calc-mingw-bin (or (getenv "MINGW_BIN") (file-name-directory (or (executable-find "gcc") (error "gcc unavailable")))))
(setenv "PATH" (concat calc-mingw-bin path-separator (getenv "PATH")))
(setenv "PKG_CONFIG_PATH" (expand-file-name "../lib/pkgconfig" calc-mingw-bin))
(add-to-list 'exec-path calc-mingw-bin)
(add-to-list 'load-path (expand-file-name "lisp" calc-nelisp-root))
(add-to-list 'load-path (expand-file-name "src" calc-nelisp-root))
(require 'nelisp-aot-compiler)
(defun calc-desktop-controls (program)
  "Generate desktop controls without touching the system clipboard in tests."
  (let (forms setup dispatch)
    (cl-labels ((blob (id text) (push `(data-blob ,id ,(concat text "\0") rodata) forms)))
      (dolist (spec '(("MS" "memory:store" 3200) ("MR" "memory:recall" 3208) ("MC" "memory:clear" 3216)
                      ("M+" "memory:add" 3224) ("M-" "memory:sub" 3232)
                      ("Copy" nil 0 on_copy) ("Paste" nil 0 on_paste) ("Always on top" "ui:topmost" 3312 on_topmost)
                      ("Recall history" "history:recall" 3248 on_history_recall) ("Clear history" "history:clear" 3256)))
        (let* ((label (car spec)) (token (cadr spec)) (offset (nth 2 spec))
               (id (intern (format "desktop_label_%s" (replace-regexp-in-string "[^a-zA-Z0-9]" "_" label))))
               (callback (or (nth 3 spec) (intern (format "desktop_action_%d" offset)))))
          (blob id label)
          (unless (nth 3 spec)
            (let ((tok (intern (format "desktop_token_%d" offset))))
              (blob tok (concat token "\n"))
              (push `(defun ,callback (widget ctx) (send_command ctx (data-addr ,tok))) forms)))
          (setq setup (append setup
                              `((let ((button (extern-call gtk_button_new_with_label (data-addr ,id))))
                                  (seq ,@(when (> offset 0) `((ptr-write-u64 ctx ,offset button)))
                                       (extern-call g_signal_connect_data button (data-addr clicked) (addr-of ,callback) ctx 0 0)
                                       (extern-call gtk_grid_attach bar button ,(if (member token '("history:clear" "history:recall")) (if (equal token "history:clear") 7 6) (length (cl-subseq setup 0)))
                                                    ,(if (member token '("history:clear" "history:recall")) 1 0) 1 1) 0)))))
          (when (and token (not (equal token "history:recall")))
            (let ((plain (intern (format "desktop_plain_%d" offset))))
              (blob plain token)
              (push `(if (= (extern-call strcmp command (data-addr ,plain)) 0)
                         (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx ,offset) (data-addr clicked)) 1) NEXT) dispatch)))))
      (blob 'desktop_compact_label "Compact / Full")
      (blob 'desktop_compact_command "ui:compact")
      (blob 'history_ellipsize "ellipsize") (blob 'history_width "max-width-chars")
      (blob 'range_apply_label "Apply range") (blob 'range_plot_label "Plot expression")
      (blob 'range_min "-10") (blob 'range_max "10")
      (dolist (p '((range_xmin . "X min") (range_xmax . "X max") (range_ymin . "Y min") (range_ymax . "Y max"))) (blob (car p) (cdr p)))
      (push `(defun setup_graph_controls (ctx page)
               (seq ,@(cl-loop for (offset label initial col row) in
                               '((3400 range_xmin range_min 0 3) (3408 range_xmax range_max 2 3)
                                 (3416 range_ymin range_min 0 5) (3424 range_ymax range_max 2 5)) collect
                               `(let ((field (extern-call gtk_entry_new)))
                                  (seq (ptr-write-u64 ctx ,offset field) (extern-call gtk_entry_set_max_length field 24)
                                       (extern-call gtk_editable_set_text field (data-addr ,initial))
                                       (extern-call gtk_editable_set_width_chars field 10)
                                       (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr ,label)) ,col ,row 2 1)
                                       (extern-call gtk_grid_attach page field ,col ,(1+ row) 2 1))))
                    ,@(cl-loop for (offset label callback col) in '((3432 range_apply_label on_graph_range 0) (3440 range_plot_label on_graph_plot 2)) collect
                               `(let ((button (extern-call gtk_button_new_with_label (data-addr ,label))))
                                  (seq (ptr-write-u64 ctx ,offset button)
                                       (extern-call gtk_grid_attach page button ,col 7 2 1)
                                       (extern-call g_signal_connect_data button (data-addr clicked) (addr-of ,callback) ctx 0 0)))) 0)) forms)
      (let ((branch 0))
        (dolist (case dispatch) (setq branch (cl-subst branch 'NEXT case)))
        (push `(defun emit_desktop_command (ctx command)
                 (if (= (extern-call strncmp command (data-addr history_prefix) 15) 0)
                   (if (= (extern-call gtk_combo_box_set_active_id (ptr-read-u64 ctx 3240) (+ command 15)) 0) 0
                     (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 3248) (data-addr clicked)) 1))
                   (if (= (extern-call strncmp command (data-addr graph_range_prefix) 12) 0)
                     (seq (set_range_fields ctx (+ command 12) 0)
                          (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 3432) (data-addr clicked)) 1)
                     (if (= (extern-call strcmp command (data-addr desktop_compact_command)) 0)
                       (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 3320) (data-addr clicked)) 1) ,branch)))) forms))
      (push `(defun setup_desktop (ctx)
               (let ((outer (extern-call gtk_box_new 1 4)) (bar (extern-call gtk_grid_new))
                     (compact (extern-call gtk_button_new_with_label (data-addr desktop_compact_label)))
                     (history (extern-call gtk_combo_box_text_new)) (memory (extern-call gtk_label_new (data-addr memory_empty))))
                 (seq (ptr-write-u64 ctx 3272 bar) (ptr-write-u64 ctx 3240 history) (ptr-write-u64 ctx 3264 memory)
                      (ptr-write-u64 ctx 3320 compact)
                      (extern-call gtk_box_append outer compact) (extern-call gtk_box_append outer bar)
                      (extern-call g_signal_connect_data compact (data-addr clicked) (addr-of on_compact) ctx 0 0)
                      (extern-call gtk_grid_set_column_spacing bar 4) (extern-call gtk_grid_set_row_spacing bar 4)
                      (extern-call gtk_widget_set_size_request history 360 32)
                      (let ((cells (extern-call gtk_cell_layout_get_cells history)))
                        (if (= cells 0) 0
                          (seq (extern-call g_object_set (ptr-read-u64 cells 0) (data-addr history_ellipsize) 3 (data-addr history_width) 48 0)
                               (extern-call g_list_free cells))))
                      (extern-call gtk_grid_attach bar memory 0 1 2 1) (extern-call gtk_grid_attach bar history 2 1 4 1)
                      ,@setup outer))) forms)
      (append program (nreverse forms)))))
(defun calc-unit-catalog ()
  "Read the engine's literal unit catalog without loading backend code."
  (let ((file (expand-file-name "lisp/nelisp-calc-modes.el" (or (getenv "NELISP_CALC_ENGINE_ROOT") calc-root))) form)
    (with-temp-buffer
      (insert-file-contents file)
      (while (and (< (point) (point-max)) (not (and (eq (car-safe form) 'defconst) (eq (cadr form) 'nelisp-calc-convert-categories))))
        (setq form (read (current-buffer))))
      (unless (eq (cadr form) 'nelisp-calc-convert-categories) (error "Unit catalog missing"))
      (cadr (nth 2 form)))))
(defun calc-product-controls (program)
  "Append native selectors and date fields for ordinary product workflows."
  (let (forms (selector-setup nil) (category-cases nil))
    (cl-labels ((blob (id text) (push `(data-blob ,id ,(concat text "\0") rodata) forms))
               (append-item (widget id text)
                 (let ((name (intern (concat "item_" id))))
                   (blob name text)
                   `(extern-call gtk_combo_box_text_append ,widget (data-addr ,name) (data-addr ,name)))))
      (dolist (p '((product_changed . "changed") (date_diff_prefix . "date:diff:") (date_add_prefix . "date:add:")
                   (date_sep . ":") (date_default . "2026-10-28") (date_end_default . "2026-10-29")
                   (date_days_default . "3") (date_start_label . "Start date (YYYY-MM-DD)")
                   (date_end_label . "End date (YYYY-MM-DD)") (date_days_label . "Days to add (negative subtracts)")
                   (date_diff_label . "Difference in days") (date_add_label . "Add days")
                   (from_label . "From") (to_label . "To") (category_label . "Category")
                   (unit_from_prefix . "convert:from:") (unit_to_prefix . "convert:to:")
                   (category_prefix . "convert:category:") (currency_from_prefix . "currency:from:")
                   (currency_to_prefix . "currency:to:") (rates_refresh_label . "Update ECB rates")
                   (rates_refresh_env . "NELISP_CALC_REFRESH_COMMAND")
                   (rates_refresh_started . "Updating ECB rates; press = again after a few seconds")
                   (rates_refresh_missing . "Rate update helper unavailable") )) (blob (car p) (cdr p)))
      (dolist (category (calc-unit-catalog))
        (let* ((name (symbol-name (car category))) (id (intern (concat "item_" name)))
               (units (mapcar (lambda (u) (symbol-name (car u))) (cdr category))))
          (blob id name)
          (push `(extern-call gtk_combo_box_text_append category (data-addr ,id) (data-addr ,id)) selector-setup)
          (push `(if (= (extern-call strcmp selected (data-addr ,id)) 0)
                    (seq (extern-call gtk_combo_box_text_remove_all (ptr-read-u64 ctx 3008))
                         (extern-call gtk_combo_box_text_remove_all (ptr-read-u64 ctx 3016))
                         ,@(cl-loop for unit in units append
                                    (list (append-item '(ptr-read-u64 ctx 3008) unit unit)
                                          (append-item '(ptr-read-u64 ctx 3016) unit unit)))
                         (extern-call gtk_combo_box_set_active (ptr-read-u64 ctx 3008) 0)
                         (extern-call gtk_combo_box_set_active (ptr-read-u64 ctx 3016) 1)) 0) category-cases)))
      (push `(defun on_category (widget ctx)
               (if (= (ptr-read-u64 ctx 248) 0)
                 (let ((selected (extern-call gtk_combo_box_get_active_id widget)))
                   (seq (ptr-write-u64 ctx 248 1) ,@(nreverse category-cases)
                        (ptr-write-u64 ctx 248 0)
                        (send_prefixed ctx (data-addr category_prefix) selected 0))) 0)) forms)
      (push '(defun send_prefixed (ctx prefix first second)
               (let ((command (extern-call calloc 512 1)))
                 (seq (extern-call strcpy command prefix) (extern-call strcat command first)
                      (if (= second 0) 0 (seq (extern-call strcat command (data-addr date_sep)) (extern-call strcat command second)))
                      (extern-call strcat command (data-addr newline)) (send_command ctx command)
                      (extern-call free command) 0))) forms)
      (dolist (spec '((on_unit_from unit_from_prefix) (on_unit_to unit_to_prefix)
                      (on_currency_from currency_from_prefix) (on_currency_to currency_to_prefix)))
        (push `(defun ,(car spec) (widget ctx)
                 (if (= (ptr-read-u64 ctx 248) 0)
                   (send_prefixed ctx (data-addr ,(cadr spec)) (extern-call gtk_combo_box_get_active_id widget) 0) 0)) forms))
      (push '(defun on_date_difference (widget ctx)
               (send_prefixed ctx (data-addr date_diff_prefix)
                              (extern-call gtk_editable_get_text (ptr-read-u64 ctx 3040))
                              (extern-call gtk_editable_get_text (ptr-read-u64 ctx 3048)))) forms)
      (push '(defun on_date_add (widget ctx)
               (send_prefixed ctx (data-addr date_add_prefix)
                              (extern-call gtk_editable_get_text (ptr-read-u64 ctx 3040))
                              (extern-call gtk_editable_get_text (ptr-read-u64 ctx 3056)))) forms)
      (push '(defun select_product_item (ctx offset id)
               (seq (ptr-write-u64 ctx 248 1)
                    (let ((found (extern-call gtk_combo_box_set_active_id (ptr-read-u64 ctx offset) id)))
                      (seq (ptr-write-u64 ctx 248 0)
                           (if (= found 0) 0
                             (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx offset) (data-addr product_changed)) 1)))))) forms)
      (let ((dispatch 0))
        (dolist (spec '((category_prefix 17 3000) (unit_from_prefix 13 3008) (unit_to_prefix 11 3016)
                        (currency_from_prefix 14 3024) (currency_to_prefix 12 3032)))
          (setq dispatch `(if (= (extern-call strncmp command (data-addr ,(car spec)) ,(cadr spec)) 0)
                              (select_product_item ctx ,(nth 2 spec) (+ command ,(cadr spec))) ,dispatch)))
        (setq dispatch
              `(if (and (= (extern-call strncmp command (data-addr date_diff_prefix) 10) 0) (>= (extern-call strlen command) 31))
                   (let ((start (extern-call strndup (+ command 10) 10)))
                     (seq (extern-call gtk_editable_set_text (ptr-read-u64 ctx 3040) start)
                          (extern-call gtk_editable_set_text (ptr-read-u64 ctx 3048) (+ command 21))
                          (extern-call free start)
                          (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 3064) (data-addr clicked)) 1))
                 (if (and (= (extern-call strncmp command (data-addr date_add_prefix) 9) 0) (>= (extern-call strlen command) 21))
                     (let ((start (extern-call strndup (+ command 9) 10)))
                       (seq (extern-call gtk_editable_set_text (ptr-read-u64 ctx 3040) start)
                            (extern-call gtk_editable_set_text (ptr-read-u64 ctx 3056) (+ command 20))
                            (extern-call free start)
                            (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 3072) (data-addr clicked)) 1)) ,dispatch)))
        (push `(defun emit_product_command (ctx command) ,dispatch) forms))
      (push '(defun on_refresh_rates (widget ctx)
               (let ((command (extern-call getenv (data-addr rates_refresh_env))))
                 (if (= command 0) (ptr-write-u64 ctx 24 (data-addr rates_refresh_missing))
                   (if (= (extern-call g_spawn_command_line_async command 0) 0)
                     (ptr-write-u64 ctx 24 (data-addr rates_refresh_missing))
                     (ptr-write-u64 ctx 24 (data-addr rates_refresh_started)))))) forms)
      (push `(defun setup_product_page (ctx page mode)
               (seq
                 (if (= (extern-call strcmp mode (data-addr mode_convert)) 0)
                   (let ((category (extern-call gtk_combo_box_text_new))
                         (from (extern-call gtk_combo_box_text_new)) (to (extern-call gtk_combo_box_text_new)))
                     (seq (ptr-write-u64 ctx 3000 category) (ptr-write-u64 ctx 3008 from) (ptr-write-u64 ctx 3016 to)
                          (ptr-write-u64 ctx 248 1) ,@(nreverse selector-setup)
                          (extern-call gtk_combo_box_set_active category 0)
                          ,@(cl-loop for u in '("m" "km" "cm" "ft" "inch") append
                                     (list (append-item 'from u u) (append-item 'to u u)))
                          (extern-call gtk_combo_box_set_active from 0) (extern-call gtk_combo_box_set_active to 3)
                          (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr category_label)) 0 1 1 1)
                          (extern-call gtk_grid_attach page category 1 1 3 1)
                          (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr from_label)) 0 2 1 1)
                          (extern-call gtk_grid_attach page from 1 2 3 1)
                          (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr to_label)) 0 3 1 1)
                          (extern-call gtk_grid_attach page to 1 3 3 1)
                          (extern-call g_signal_connect_data category (data-addr product_changed) (addr-of on_category) ctx 0 0)
                          (extern-call g_signal_connect_data from (data-addr product_changed) (addr-of on_unit_from) ctx 0 0)
                          (extern-call g_signal_connect_data to (data-addr product_changed) (addr-of on_unit_to) ctx 0 0)
                          (ptr-write-u64 ctx 248 0))) 0)
                 (if (= (extern-call strcmp mode (data-addr mode_currency)) 0)
                   (let ((from (extern-call gtk_combo_box_text_new)) (to (extern-call gtk_combo_box_text_new))
                         (refresh (extern-call gtk_button_new_with_label (data-addr rates_refresh_label))))
                     (seq (ptr-write-u64 ctx 3024 from) (ptr-write-u64 ctx 3032 to)
                          ,@(cl-loop for code in '("EUR" "USD" "JPY" "CZK" "DKK" "GBP" "HUF" "PLN" "RON" "SEK" "CHF" "ISK" "NOK" "TRY" "AUD" "BRL" "CAD" "CNY" "HKD" "IDR" "ILS" "INR" "KRW" "MXN" "MYR" "NZD" "PHP" "SGD" "THB" "ZAR") append
                                     (list (append-item 'from code code) (append-item 'to code code)))
                          (extern-call gtk_combo_box_set_active from 0) (extern-call gtk_combo_box_set_active to 1)
                          (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr from_label)) 0 1 1 1)
                          (extern-call gtk_grid_attach page from 1 1 3 1)
                          (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr to_label)) 0 2 1 1)
                          (extern-call gtk_grid_attach page to 1 2 3 1)
                          (extern-call gtk_grid_attach page refresh 0 3 4 1)
                          (extern-call g_signal_connect_data from (data-addr product_changed) (addr-of on_currency_from) ctx 0 0)
                          (extern-call g_signal_connect_data to (data-addr product_changed) (addr-of on_currency_to) ctx 0 0)
                          (extern-call g_signal_connect_data refresh (data-addr clicked) (addr-of on_refresh_rates) ctx 0 0))) 0)
                 (if (= (extern-call strcmp mode (data-addr mode_date)) 0)
                   (seq ,@(cl-loop for (offset label initial row) in
                                   '((3040 date_start_label date_default 1) (3048 date_end_label date_end_default 2) (3056 date_days_label date_days_default 3)) collect
                                  `(let ((field (extern-call gtk_entry_new)))
                                     (seq (ptr-write-u64 ctx ,offset field) (extern-call gtk_entry_set_max_length field 32)
                                          (extern-call gtk_editable_set_text field ,(if (memq offset '(3040 3048))
                                            '(if (= (extern-call getenv (data-addr today_env)) 0) (data-addr date_default) (extern-call getenv (data-addr today_env)))
                                            `(data-addr ,initial)))
                                          (extern-call gtk_grid_attach page (extern-call gtk_label_new (data-addr ,label)) 0 ,row 2 1)
                                          (extern-call gtk_grid_attach page field 2 ,row 2 1))))
                        ,@(cl-loop for (offset label callback col) in '((3064 date_diff_label on_date_difference 0) (3072 date_add_label on_date_add 2)) collect
                                   `(let ((button (extern-call gtk_button_new_with_label (data-addr ,label))))
                                      (seq (ptr-write-u64 ctx ,offset button)
                                           (extern-call gtk_grid_attach page button ,col 4 2 1)
                                           (extern-call g_signal_connect_data button (data-addr clicked) (addr-of ,callback) ctx 0 0))))) 0) 0)) forms)
      (append program (nreverse forms)))))
(defun calc-advanced-controls (program)
  "Generate native GTK controls and real signal automation for all modes."
  (let* ((modes '("standard" "scientific" "programmer" "convert" "date" "graph" "currency"))
         (controls
          '(("scientific" ("DEG" "angle:deg") ("RAD" "angle:rad")
             ("sqrt" "function:sqrt") ("sin" "function:sin") ("cos" "function:cos")
             ("tan" "function:tan") ("log" "function:log") ("ln" "function:ln")
             ("exp" "function:exp") ("x squared" "function:square")
             ("1/x" "function:reciprocal") ("n!" "function:factorial"))
            ("programmer" ("HEX" "prog:base:hex") ("DEC" "prog:base:dec")
             ("Signed" "prog:signed") ("Unsigned" "prog:unsigned")
             ("OCT" "prog:base:oct") ("BIN" "prog:base:bin")
             ("8 bit" "prog:word:8") ("16 bit" "prog:word:16")
             ("32 bit" "prog:word:32") ("64 bit" "prog:word:64")
             ("A" "A") ("B" "B") ("C digit" "C") ("D" "D") ("E" "E") ("F" "F")
             ("AND" "prog:and") ("OR" "prog:or") ("XOR" "prog:xor")
             ("NOT" "prog:not") ("<<" "prog:shl") (">>" "prog:shr")
             ("Rotate L" "prog:rol") ("Rotate R" "prog:ror"))
            ("convert" ("Length" "convert:category:length")
             ("Volume l / ml" "convert:category:volume") ("Area m2 / ft2" "convert:category:area")
             ("Mass kg / g" "convert:category:mass") ("Temperature C / F" "convert:category:temp")
             ("Energy J / kJ" "convert:category:energy") ("Speed m/s / kph" "convert:category:speed")
             ("Time s / min" "convert:category:time") ("Power W / kW" "convert:category:power")
             ("Data byte / bit" "convert:category:data") ("Pressure Pa / kPa" "convert:category:pressure")
             ("Angle deg / rad" "convert:category:angle")
             ("From m" "convert:from:m") ("From ft" "convert:from:ft")
             ("From km" "convert:from:km") ("To m" "convert:to:m")
             ("To ft" "convert:to:ft") ("To km" "convert:to:km"))
            ("date" ("Example: date difference" "date:diff:2026-10-28:2026-10-29")
             ("Example: add 3 days" "date:add:2026-10-28:3"))
            ("graph" ("Plot x^2" "graph:x^2") ("Plot sin(x)" "graph:sin(x)")
             ("Range -10 .. 10" "graph:range:-10:10:-10:10"))
            ("currency" ("From EUR" "currency:from:EUR") ("From USD" "currency:from:USD")
             ("From JPY" "currency:from:JPY") ("To EUR" "currency:to:EUR")
             ("To USD" "currency:to:USD") ("To JPY" "currency:to:JPY"))))
         forms setup emit (index 0))
    (setq controls (cl-remove-if (lambda (x) (member (car x) '("convert" "date" "currency"))) controls))
    (cl-labels
        ((blob (id text) (push `(data-blob ,id ,(concat text "\0") rodata) forms))
         (button (label token parent col row mode)
           (let* ((i index) (offset (+ 256 (* i 8)))
                  (label-id (intern (format "advanced_label_%d" i)))
                  (token-id (intern (format "advanced_token_%d" i)))
                  (plain-id (intern (format "advanced_plain_%d" i)))
                  (callback (intern (format "advanced_click_%d" i))))
             (setq index (1+ index))
             (blob label-id label) (blob token-id (concat token "\n")) (blob plain-id token)
             (push `(defun ,callback (widget ctx)
                      (seq ,@(when mode
                               `((extern-call gtk_stack_set_visible_child_name (ptr-read-u64 ctx 192) (data-addr ,(intern (concat "mode_" mode))))
                                 (ptr-write-u64 ctx 216 (data-addr ,label-id))
                                 (ptr-write-u64 ctx 3120 ,(cl-position mode modes :test #'equal))
                                 (ptr-write-u64 ctx 240 ,(if (equal mode "graph") 1 0))))
                           (send_command ctx (data-addr ,token-id)) 0)) forms)
             (setq setup (append setup
                         `((let ((button (extern-call gtk_button_new_with_label (data-addr ,label-id))))
                             (seq (ptr-write-u64 ctx ,offset button)
                                  (extern-call gtk_widget_set_tooltip_text button (data-addr ,label-id))
                                  (extern-call g_signal_connect_data button (data-addr clicked) (addr-of ,callback) ctx 0 0)
                                  (extern-call gtk_grid_attach ,parent button ,col ,row 1 1) 0)))))
             (push `(if (= (extern-call strcmp command (data-addr ,plain-id)) 0)
                        (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx ,offset) (data-addr clicked)) 1)
                      NEXT) emit))))
      (dolist (mode modes) (blob (intern (concat "mode_" mode)) mode))
      (blob 'help_standard "Use the keypad or enter an expression above.")
      (blob 'help_scientific "Type sin(30) or use unary functions on the display.")
      (blob 'help_programmer "Choose base and word size before entering digits.")
      (blob 'help_convert "Choose a category and From / To units, enter the amount on the keypad, then press =.")
      (blob 'help_date "Enter the start and end dates for a difference, or the start date and signed number of days to add.")
      (blob 'help_graph "Enter x^2 or sin(x) above and press Enter. The chart covers -10 to 10 by default; its crosshair marks the midpoint.")
      (blob 'help_currency "Choose currencies, type amount on the keypad, then =. Requires cached ECB rates; status shows rate date.")
