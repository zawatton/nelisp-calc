(defun calc-expand (form)
  "Expand the Sumi drawing vocabulary before AOT compilation."
  (cond
   ((not (consp form)) form)
   ((eq (car form) 'fill_rect)
    (pcase-let ((`(,_ ,cr ,r ,g ,b ,x ,y ,w ,h) form))
      `(seq (extern-call cairo_set_source_rgb ,cr (:f64 ,r) (:f64 ,g) (:f64 ,b))
            (extern-call cairo_rectangle ,cr (:f64 ,x) (:f64 ,y) (:f64 ,w) (:f64 ,h))
            (extern-call cairo_fill ,cr) 0)))
   ((eq (car form) 'text_at)
    (pcase-let ((`(,_ ,cr ,string ,size ,r ,g ,b ,x ,y ,font) form))
      `(seq (extern-call cairo_set_source_rgb ,cr (:f64 ,r) (:f64 ,g) (:f64 ,b))
            (extern-call cairo_select_font_face ,cr ,font 0 0)
            (extern-call cairo_set_font_size ,cr (:f64 ,size))
            (extern-call cairo_move_to ,cr (:f64 ,x) (:f64 ,y))
            (extern-call cairo_show_text ,cr ,string) 0)))
   (t (mapcar #'calc-expand form))))
(let* ((target (expand-file-name "target" calc-root))
       (object (expand-file-name "native-calc.o" target))
       (exe (expand-file-name (or (getenv "NELISP_CALC_GUI_OUTPUT") "nelisp-calc.exe") target))
       (program (with-temp-buffer (insert-file-contents (expand-file-name "src/nelisp-calc-gui.el" calc-root)) (read (current-buffer))))
       (buttons '(("%" "percent" 37) ("C" "clear" 65307) ("Back" "backspace" 65288) ("/" "div" 47)
                  ("7" "7" 55) ("8" "8" 56) ("9" "9" 57) ("*" "mul" 42)
                  ("4" "4" 52) ("5" "5" 53) ("6" "6" 54) ("-" "sub" 45)
                  ("1" "1" 49) ("2" "2" 50) ("3" "3" 51) ("+" "add" 43)
                  ("+/-" "sign" 110) ("0" "0" 48) ("." "dot" 46) ("=" "equals" 65293)))
       draw click keys mouse)
  (make-directory target t)
  (make-directory (file-name-directory exe) t)
  (cl-loop for (label token key) in buttons for i from 0
           for x = (+ 12 (* (% i 4) 97)) for y = (+ 190 (* (/ i 4) 70))
           for label-id = (intern (format "label_%d" i)) for token-id = (intern (format "token_%d" i)) do
           (setq program (append program `((data-blob ,label-id ,(concat label "\0") rodata)
                                           (data-blob ,token-id ,(concat token "\n\0") rodata))))
           (setq draw (append draw `((fill_rect cr ,(if (= i 19) 0.22 0.18) ,(if (= i 19) 0.49 0.19) ,(if (= i 19) 0.72 0.21) ,(float x) ,(float y) 91.0 64.0)
                                    (text_at cr (data-addr ,label-id) 22.0 0.96 0.96 0.97 ,(+ x 24.0) ,(+ y 40.0) (data-addr sans)))))
           (push `(if (and (>= ix ,x) (< ix ,(+ x 91)) (>= iy ,y) (< iy ,(+ y 64))) (send_command ctx (data-addr ,token-id)) 0) click)
           (push `(if (= keyval ,key) (send_command ctx (data-addr ,token-id)) 0) keys)
           (push `(if (= key ,(if (= i 19) 61 key))
                      (let ((values (extern-call calloc 4 24)))
                        (seq
                         (extern-call g_value_init values 80)
                         (extern-call g_value_set_object values (ptr-read-u64 ctx 176))
                         (extern-call g_value_init (+ values 24) 24)
                         (extern-call g_value_set_int (+ values 24) 1)
                         (extern-call g_value_init (+ values 48) 60)
                         (extern-call g_value_set_double (+ values 48) (:f64 ,(+ x 45.0)))
                         (extern-call g_value_init (+ values 72) 60)
                         (extern-call g_value_set_double (+ values 72) (:f64 ,(+ y 32.0)))
                         (extern-call g_signal_emitv values
                                      (extern-call g_signal_lookup (data-addr pressed) (extern-call g_type_from_name (data-addr gesture_type))) 0 0)
                         (extern-call g_value_unset values)
                         (extern-call g_value_unset (+ values 24))
                         (extern-call g_value_unset (+ values 48))
                         (extern-call g_value_unset (+ values 72))
                         (extern-call free values) 0)) 0) mouse)
