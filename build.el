                         (text_at cr (ptr-read-u64 ctx 216) 24.0 0.96 0.96 0.97 16.0 42.0 (data-addr sans))
                         (extern-call cairo_save cr)
                         (extern-call cairo_rectangle cr (:f64 12.0) (:f64 58.0) (:f64 376.0) (:f64 112.0))
                         (extern-call cairo_clip cr)
                         (text_at cr (if (> (ptr-read-u64 ctx 136) 0) (data-addr queue_full) (ptr-read-u64 ctx 24))
                                  (i64-to-f64 (if (> (extern-call strlen (ptr-read-u64 ctx 24)) 55) 9 12))
                                  0.64 0.72 0.79 16.0 83.0 (data-addr sans))
                         (text_at cr (ptr-read-u64 ctx 16)
                                  (i64-to-f64 (if (> (extern-call strlen (ptr-read-u64 ctx 16)) 32) 10
                                    (if (> (extern-call strlen (ptr-read-u64 ctx 16)) 18) 18 36)))
                                  0.98 0.98 0.99 16.0 145.0 (data-addr sans))
