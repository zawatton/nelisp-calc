                   (let ((code (apply #'call-process "gcc" nil t nil object (append flags (list "-luser32" "-mwindows" "-o" exe)))))
                     (unless (eq code 0) (error "Link failed: %s" (buffer-string)))))))
  (princ (format "NATIVE-CALC-BUILD-OK %s\n" exe))))
