                  (defun on_key (controller keyval keycode state ctx)
                    (seq ,@(reverse keys)
                         (if (= keyval 61) (send_command ctx (data-addr token_19)) 0)
                         (if (= keyval 65421) (send_command ctx (data-addr token_19)) 0) 1)))))
  (setq program (calc-advanced-controls program))
  (setq program (calc-product-controls program))
  (setq program (calc-desktop-controls program))
  (setq program (cons 'seq (mapcar #'calc-expand (cl-remove-if
                       (lambda (form) (and (eq (car-safe form) 'defun)
                                          (memq (cadr form) '(fill_rect text_at)))) (cdr program)))))
  (nelisp-aot-compile-to-object program object :format 'coff)
