;;; gestures.el --- Hidden native gesture signal fixtures -*- lexical-binding: t; -*-
(defun calc-gesture-controls (program)
  "Add bounded native signal fixtures without physical input or presentation."
  (let ((forms
         '((data-blob drag_type "GtkGestureDrag\0" rodata)
           (data-blob scroll_type "GtkEventControllerScroll\0" rodata)
           (data-blob gesture_receipts "gesture-receipts.txt\0" rodata)
           (data-blob gesture_grouped "gesture-grouped.txt\0" rodata)
           (data-blob gesture_true "1\0" rodata)
           (data-blob gesture_receipt_format "%s\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\t%lld\n\0" rodata)
           (data-blob gesture_pair "%lld:%lld\0" rodata)
           (data-blob gesture_mode_standard "mode:standard\0" rodata)
           (data-blob gesture_busy_token "graph:zoom:1\n\0" rodata)
           (defun gesture_receipt (ctx signal handled)
             (let ((fp (extern-call fopen (data-addr gesture_receipts) (data-addr append_mode))))
               (if (= fp 0) 0
                 (seq (extern-call g_file_set_contents (data-addr gesture_grouped)
                        (if (= (extern-call gtk_gesture_is_grouped_with (ptr-read-u64 ctx 6304) (ptr-read-u64 ctx 176)) 1) (data-addr gesture_true) (data-addr initial)) -1 0)
                      (extern-call fprintf fp (data-addr gesture_receipt_format) signal handled
                       (ptr-read-u64 ctx 6320) (ptr-read-u64 ctx 6328)
                       (if (= (ptr-read-u64 ctx 6336) 0) 0 1)
                       (- (ptr-read-u64 ctx 152) (ptr-read-u64 ctx 144)) (ptr-read-u64 ctx 32)
                       (extern-call gtk_event_controller_get_propagation_phase (ptr-read-u64 ctx 6304))
                       (extern-call gtk_event_controller_get_propagation_phase (ptr-read-u64 ctx 6312))
                       (extern-call gtk_gesture_single_get_button (ptr-read-u64 ctx 6304))
                       (extern-call gtk_event_controller_scroll_get_flags (ptr-read-u64 ctx 6312))
                       (if (= (extern-call gtk_event_controller_get_widget (ptr-read-u64 ctx 6304)) (ptr-read-u64 ctx 8)) 1 0)
                       (if (= (extern-call gtk_event_controller_get_widget (ptr-read-u64 ctx 6312)) (ptr-read-u64 ctx 8)) 1 0)
                       (graph_dimension ctx 6344 400) (graph_dimension ctx 6352 560))
                      (extern-call fclose fp) 0))))
           (defun emit_gesture_signal (ctx signal scroll ax ay)
             (let ((values (extern-call calloc 3 24)) (result (extern-call calloc 1 24))
                   (controller (ptr-read-u64 ctx (if (= scroll 1) 6312 6304))))
               (seq
                ;; Sentinel values belong only to hidden fixtures, for ABI guards.
                (ptr-write-u64 ctx 6400 (if (= ax 2147483647) 9221120237041090560
                  (f64-bits (f64-div (i64-to-f64 ax) 1000.0))))
                (ptr-write-u64 ctx 6408 (if (= ay 2147483647) 9218868437227405312
                  (f64-bits (f64-div (i64-to-f64 ay) 1000.0))))
                (extern-call g_value_init values 80) (extern-call g_value_set_object values controller)
                (extern-call g_value_init (+ values 24) 60)
                (extern-call g_value_set_double (+ values 24) (:f64 (bits-to-f64 (ptr-read-u64 ctx 6400))))
                (extern-call g_value_init (+ values 48) 60)
                (extern-call g_value_set_double (+ values 48) (:f64 (bits-to-f64 (ptr-read-u64 ctx 6408))))
                (if (= scroll 1) (extern-call g_value_init result 20) 0)
                (extern-call g_signal_emitv values
                  (extern-call g_signal_lookup signal (extern-call g_type_from_name (if (= scroll 1) (data-addr scroll_type) (data-addr drag_type))))
                  0 (if (= scroll 1) result 0))
                (gesture_receipt ctx signal (if (= scroll 1) (extern-call g_value_get_boolean result) -1))
                (extern-call g_value_unset values) (extern-call g_value_unset (+ values 24))
                (extern-call g_value_unset (+ values 48))
                (if (= scroll 1) (extern-call g_value_unset result) 0)
                (extern-call free values) (extern-call free result) 0)))
           (defun emit_scroll_repeat (ctx delta count)
             (if (> count 0)
               (seq (emit_gesture_signal ctx (data-addr scroll_signal) 1 0 delta)
                    (emit_scroll_repeat ctx delta (- count 1))) 0))))
        dispatch)
    (dolist (kind '("begin" "update" "end" "scroll" "pair" "repeat" "cancel" "mode" "busy" "size"))
      (let* ((id (intern (concat "gesture_command_" kind)))
             (prefix (concat "ui:gesture:" kind ":"))
             (action
              (cond
               ((member kind '("begin" "update" "end"))
                `(emit_gesture_signal ctx (data-addr ,(intern (concat "drag_" kind))) 0 a b))
               ((equal kind "scroll") '(emit_gesture_signal ctx (data-addr scroll_signal) 1 a b))
               ((equal kind "pair") '(seq (emit_gesture_signal ctx (data-addr scroll_signal) 1 0 a)
                                          (emit_gesture_signal ctx (data-addr scroll_signal) 1 0 b)))
               ((equal kind "repeat") '(emit_scroll_repeat ctx a (max 0 (min 32 b))))
               ((equal kind "cancel") '(seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx 6304) (data-addr drag_cancel) 0)
                                            (gesture_receipt ctx (data-addr drag_cancel) -1)))
               ((equal kind "mode") '(seq (emit_gesture_signal ctx (data-addr scroll_signal) 1 0 a)
                                          (emit_command ctx (data-addr gesture_mode_standard))
                                          (gesture_receipt ctx (data-addr mode_prefix) -1)))
               ((equal kind "busy") '(seq (send_command ctx (data-addr gesture_busy_token))
                                          (emit_gesture_signal ctx (data-addr drag_begin) 0 200000 365000)
                                          (emit_gesture_signal ctx (data-addr drag_end) 0 a b)
                                          (emit_gesture_signal ctx (data-addr scroll_signal) 1 0 -1000)
                                          (emit_gesture_signal ctx (data-addr scroll_signal) 1 0 -1000)))
               ((equal kind "size") '(seq (extern-call gtk_widget_allocate (ptr-read-u64 ctx 8) (max 400 (min 800 a)) (max 560 (min 1120 b)) -1 0)
                                          (gesture_receipt ctx (data-addr gesture_command_size) -1))))))
        (push `(data-blob ,id ,(concat prefix "\0") rodata) forms)
        (push `(if (= (extern-call strncmp command (data-addr ,id) ,(length prefix)) 0)
                   (seq (ptr-write-u64 ctx 6416 0) (ptr-write-u64 ctx 6424 0)
                     (if (= (extern-call sscanf (+ command ,(length prefix)) (data-addr gesture_pair) (+ ctx 6416) (+ ctx 6424)) 2)
                       (let ((a (ptr-read-u64 ctx 6416)) (b (ptr-read-u64 ctx 6424))) ,action) 0) 1) NEXT)
              dispatch)))
    (let ((tail 0))
      (dolist (branch dispatch) (setq tail (cl-subst tail 'NEXT branch)))
      (push `(defun emit_graph_gesture_command (ctx command) ,tail) forms))
    (append program (nreverse forms))))
