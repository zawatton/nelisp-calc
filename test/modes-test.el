;;; modes-test.el --- Host and standalone mode checks -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-modes.el" root) nil t))
(defvar modes-checks 0)
(defun modes-check (expected tokens)
  (dolist (token tokens) (nelisp-calc-modes-token token))
  (unless (equal expected nelisp-calc-display) (error "Expected %S got %S (%s) tokens %S" expected nelisp-calc-display nelisp-calc-status tokens))
  (setq modes-checks (1+ modes-checks)))
(defun modes-input (s) (mapcar #'char-to-string (string-to-list s)))
(modes-check "18446744073709551615" '("mode:programmer" "prog:not"))
(modes-check "FFFFFFFFFFFFFFFF" '("prog:base:hex"))
(modes-check "0" '("+" "1" "="))
(modes-check "FF" '("prog:word:8" "prog:not"))
(modes-check "FE" '("prog:shl"))
(modes-check "7F" '("prog:shr"))
(modes-check "FE" '("prog:rol"))
(modes-check "7F" '("prog:ror"))
(modes-check "F" '("prog:and" "F" "="))
(modes-check "ERROR" '("/" "0" "="))
(modes-check "0" '("clear"))
(modes-check "1" '("1" "prog:word:64"))
(modes-check "18446744073709551615" '("prog:base:dec" "clear" "0" "-" "1" "="))
(modes-check "9223372036854775807" '("/" "2" "="))
(modes-check "3" '("clear" "1" "add" "2" "equals"))
(modes-check "1" '("mode:date" "date:diff:2026-10-28:2026-10-29"))
(modes-check "2024-02-29" '("date:add:2024-02-28:1"))
(modes-check "2025-01-01" '("date:add:2024-12-31:1"))
(modes-check "2000-03-01" '("date:add:2000-02-29:1"))
(modes-check "ERROR" '("date:add:1900-02-29:1"))
(modes-check "ERROR" '("date:add:9999-12-31:1"))
(princ (format "MODES-CORE-PASS:%d\n" modes-checks))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Genuine Calc unavailable: %s" nelisp-calc-engine-error))
(modes-check "32" '("mode:convert" "convert:category:temp" "convert:from:c" "convert:to:f" "0" "="))
(modes-check "0" '("clear" "convert:from:f" "convert:to:c" "3" "2" "="))
(modes-check "10" '("clear" "convert:category:speed" "convert:from:kph" "convert:to:mps" "3" "6" "="))
(modes-check "1" '("clear" "convert:category:data" "convert:from:bit" "convert:to:byte" "8" "="))
(modes-check "1.5" '("clear" "convert:from:byte" "convert:to:byte" "1" "dot" "5" "equals"))
(princ (format "MODES-PASS:%d\n" modes-checks))
