;;; engine-reference.el --- Host reference and standalone assertions -*- lexical-binding: t; -*-
(load (expand-file-name "../lisp/nelisp-calc-engine.el"
                        (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t))) nil t)
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "ENGINE-UNAVAILABLE: %s" nelisp-calc-engine-error))
(let ((cases '(("0.1+0.2" "0.3") ("2+3*4" "14")
               ("sqrt(2)" "1.41421356237") ("sin(30)" "0.5"))))
  (dolist (case cases)
    (let ((result (nelisp-calc-evaluate (car case))))
      (unless (and (plist-get result :ok)
                   (equal (plist-get result :value) (cadr case)))
        (error "FAILED %S: %S" case result)))))
(unless (equal (plist-get (nelisp-calc-evaluate "sqrt(2)" 30) :value)
               "1.41421356237309504880168872421")
  (error "Precision assertion failed"))
(when (plist-get (nelisp-calc-evaluate "2+(") :ok)
  (error "Malformed expression was accepted"))
(when (plist-get (nelisp-calc-evaluate "1/0") :ok)
  (error "Symbolic undefined quotient was accepted as a numeric result"))
(dolist (case '((("2" "add" "3" "mul" "4" "equals") "20")
                (("2" "add" "3" "equals" "equals") "8")
                (("2" "0" "0" "add" "1" "0" "percent" "equals") "220")
                (("2" "0" "0" "mul" "1" "0" "percent" "equals") "20")
                (("1" "dot" "dot" "5") "1.5")
                (("2" "add" "9" "ce" "3" "equals") "5")
                (("1" "div" "0" "equals") "ERROR")
                (("1" "div" "0" "equals" "7") "7")))
  (nelisp-calc-token "clear")
  (dolist (token (car case)) (nelisp-calc-token token))
  (unless (equal nelisp-calc-display (cadr case))
    (error "Token integration failed %S: %S" case nelisp-calc-display)))
(setq nelisp-calc-engine-error "negative-control")
(when (plist-get (nelisp-calc-evaluate "2+2") :ok)
  (error "Unavailable engine was reported successful"))
(princ "ENGINE-REFERENCE-PASS\n")
