;;; graph-test.el --- Genuine Calc graphs and fixture currency -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-modes.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-graph.el" root) nil t))
(defvar graph-checks 0)
(defvar graph-test-old-clock (getenv "NELISP_CALC_TODAY"))
(setenv "NELISP_CALC_TODAY" "2026-10-28")
(defun graph-check (condition label)
  (unless condition (error "Graph check failed: %s; display=%s status=%s" label nelisp-calc-display nelisp-calc-status))
  (setq graph-checks (1+ graph-checks)))
(defun graph-file () (with-temp-buffer (insert-file-contents (nelisp-calc-graph-target)) (buffer-string)))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Calc unavailable: %s" nelisp-calc-engine-error))
(setq nelisp-calc-graph-samples 101)
(setenv "NELISP_CALC_TARGET" (expand-file-name "target/graph-fixture" nelisp-calc-root))
(nelisp-calc-graph-token "mode:graph")
(nelisp-calc-graph-token "graph:x^2")
(graph-check (string-prefix-p "ok:graph:" nelisp-calc-status) "square calculates")
(graph-check (string-match "1 500 500\n" (graph-file)) "square zero at viewport center")
(graph-check (and (string-match "1 400 300\n" (graph-file))
                  (string-match "1 350 50\n" (graph-file))) "square projection goldens exact within one pixel")
(graph-check (string-match "0 0 0\n" (graph-file)) "square clipping creates breaks")
(princ "GRAPH-SQUARE-PASS:4\n")
(nelisp-calc-graph-token "graph:1/x")
(graph-check (string-prefix-p "ok:graph:" nelisp-calc-status) "reciprocal calculates")
(graph-check (string-match "0 0 0\n" (graph-file)) "reciprocal zero creates discontinuity")
(princ "GRAPH-RECIPROCAL-PASS:2\n")
(defvar graph-accepted-before-error (graph-file))
(nelisp-calc-graph-token "graph:invalid_function(x)")
(graph-check (equal nelisp-calc-display "ERROR") "invalid expression error")
(graph-check (equal (graph-file) graph-accepted-before-error) "invalid expression preserves accepted plot")
(nelisp-calc-graph-token "graph:range:10:-10:-10:10")
(graph-check (equal nelisp-calc-display "ERROR") "inverted range error")
(let ((fixture (expand-file-name "target/graph-fixture/FIXTURE-currency-rates.tsv" nelisp-calc-root)))
  (setenv "NELISP_CALC_RATES" fixture)
  ;; Deliberately synthetic test data, never installed as production rates.
  (with-temp-file fixture (insert (concat "date=" (nelisp-calc-currency-today) "\nEUR\t1\nUSD\t2\nJPY\t4\n")))
  (nelisp-calc-graph-token "mode:currency")
  (nelisp-calc-graph-token "currency:from:EUR")
  (nelisp-calc-graph-token "currency:to:USD")
  (nelisp-calc-graph-token "3") (nelisp-calc-graph-token "=")
  (graph-check (equal nelisp-calc-display "6") "EUR base conversion")
  (nelisp-calc-graph-token "clear")
  (nelisp-calc-graph-token "currency:from:JPY")
  (nelisp-calc-graph-token "8") (nelisp-calc-graph-token "=")
  (graph-check (equal nelisp-calc-display "4") "cross-currency ratio")
  (with-temp-file fixture (insert "date=2000-01-01\nEUR\t1\nUSD\t2\nJPY\t4\n"))
  (nelisp-calc-graph-token "=")
  (graph-check (string-prefix-p "stale:currency:ECB:2000-01-01" nelisp-calc-status) "stale cache visible")
  (with-temp-file fixture (insert "date=2026-10-29\nEUR\t1\nUSD\t2\nJPY\t4\n"))
  (nelisp-calc-graph-token "=")
  (graph-check (equal nelisp-calc-display "ERROR") "future cache rejected")
  (with-temp-file fixture (insert "date=2026-02-30\nEUR\t1\nUSD\t2\n"))
  (nelisp-calc-graph-token "=")
  (graph-check (equal nelisp-calc-display "ERROR") "invalid cache date")
  (with-temp-file fixture (insert "date=2000-01-01\nEUR\t1\nUSD\t0\n"))
  (nelisp-calc-graph-token "=")
  (graph-check (equal nelisp-calc-display "ERROR") "invalid rate")
  (setenv "NELISP_CALC_RATES" (concat fixture ".missing"))
  (nelisp-calc-graph-token "=")
  (graph-check (equal nelisp-calc-display "ERROR") "missing cache"))
(setenv "NELISP_CALC_TODAY" graph-test-old-clock)
(princ (format "GRAPH-PASS:%d\n" graph-checks))
