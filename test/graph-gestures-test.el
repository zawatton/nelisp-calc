;;; graph-gestures-test.el --- Atomic gesture viewport contracts -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-modes.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-graph.el" root) nil t))
(defvar gestures-checks 0)
(defun gestures-check (value label)
  (unless value (error "Gesture contract failed: %s; range=%S status=%s" label nelisp-calc-graph-range nelisp-calc-status))
  (setq gestures-checks (1+ gestures-checks)))
(defun gestures-file (name)
  (with-temp-buffer (insert-file-contents (expand-file-name name (file-name-directory (nelisp-calc-graph-target)))) (buffer-string)))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Calc unavailable: %s" nelisp-calc-engine-error))
(setenv "NELISP_CALC_TARGET" (expand-file-name (or (getenv "GESTURES_TARGET") "target/gestures-fixture") nelisp-calc-root))
(nelisp-calc-graph-token "mode:graph")
(nelisp-calc-graph-token "graph:zoom:2")
(gestures-check (equal nelisp-calc-graph-range '("-2.5" "2.5" "-2.5" "2.5")) "two positive zoom steps")
(gestures-check (string-prefix-p "ok:graph:x^2:" nelisp-calc-status) "genuine Calc graph")
(gestures-check (string-match "1 500 500\n" (gestures-file "graph.txt")) "real square center")
(nelisp-calc-graph-token "graph:shift:250:-250")
(gestures-check (equal nelisp-calc-graph-range '("-1.25" "3.75" "-3.75" "1.25")) "signed quarter viewport displacement")
(gestures-check (equal (gestures-file "graph-range.txt") "-1.25:3.75:-3.75:1.25") "authoritative snapshot")
(gestures-check (equal nelisp-calc-graph-expression "x^2") "retained expression")
(let ((range (copy-sequence nelisp-calc-graph-range)) (graph (gestures-file "graph.txt"))
      (snapshot (gestures-file "graph-range.txt")))
  (dolist (token '("graph:zoom:5" "graph:zoom:-5" "graph:zoom:0" "graph:zoom:junk"
                   "graph:shift:2001:0" "graph:shift:0:-2001" "graph:shift:0:1.5"
                   "graph:shift:0:1:2" "graph:shift:NaN:0" "graph:shift:0:0"))
    (nelisp-calc-graph-token token)
    (gestures-check (equal nelisp-calc-display "ERROR") "visible invalid-token error")
    (gestures-check (and (equal nelisp-calc-graph-range range)
                         (equal nelisp-calc-graph-expression "x^2")
                         (equal (gestures-file "graph.txt") graph)
                         (equal (gestures-file "graph-range.txt") snapshot)) "invalid gesture preserves accepted state")))
(nelisp-calc-graph-token "graph:zoom:-2")
(gestures-check (equal nelisp-calc-graph-range '("-8.75" "11.25" "-11.25" "8.75")) "zoom out preserves translated center")
(setq nelisp-calc-mode 'standard)
(gestures-check (not (nelisp-calc-graph-token "graph:zoom:1")) "other mode ignores gesture")
(princ (format "GESTURES-PASS:%d\n" gestures-checks))
