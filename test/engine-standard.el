;;; engine-standard.el --- Genuine Standard end-to-end gate -*- lexical-binding: t; -*-
(load (expand-file-name "../lisp/nelisp-calc-engine.el"
                        (file-name-directory
                         (replace-regexp-in-string "\\\\" "/" load-file-name t t))) nil t)
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "ENGINE-UNAVAILABLE: %s" nelisp-calc-engine-error))
(dolist (case '((("0" "dot" "1" "add" "0" "dot" "2" "equals") "0.3")
                (("2" "add" "3" "mul" "4" "equals") "20")
                (("2" "add" "3" "equals" "equals") "8")
                (("2" "0" "0" "add" "1" "0" "percent" "equals") "220")
                (("2" "0" "0" "mul" "1" "0" "percent" "equals") "20")
                (("1" "dot" "dot" "5") "1.5")
                (("2" "add" "9" "ce" "3" "equals") "5")
                (("1" "div" "0" "equals") "ERROR")
                (("1" "div" "0" "equals" "7") "7")))
  (nelisp-calc-token "clear")
  (dolist (token (car case)) (nelisp-calc-token token))
  (unless (equal nelisp-calc-display (cadr case))
    (error "Standard failed %S: %S [%s]" case nelisp-calc-display nelisp-calc-status)))
(when (plist-get (nelisp-calc-evaluate "2+(") :ok)
  (error "Malformed expression accepted"))
(dolist (case '(("1/3" "0.333333333333") ("1/7" "0.142857142857")))
  (unless (equal (plist-get (nelisp-calc-evaluate (car case)) :value) (cadr case))
    (error "Ordinary division failed: %S" case)))
(setq nelisp-calc-engine-error "negative-control")
(when (plist-get (nelisp-calc-evaluate "2+2") :ok)
  (error "Engine failure reported as successful arithmetic"))
(princ "ENGINE-STANDARD-PASS\n")
