;;; parity-integration-test.el --- Cross-module genuine Calc checks -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory
                                    (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t))
(defvar parity-integration-checks 0)
(defun parity-integration-check (condition label)
  "Require CONDITION for the independent integration LABEL."
  (unless condition (error "Parity integration failed: %s; display=%s status=%s"
                           label nelisp-calc-display nelisp-calc-status))
  (setq parity-integration-checks (1+ parity-integration-checks)))
(defun parity-integration-plot ()
  "Read the private integration plot."
  (with-temp-buffer (insert-file-contents (nelisp-calc-graph-target)) (buffer-string)))
(nelisp-calc-initialize)
(parity-integration-check (not nelisp-calc-engine-error) "genuine engine available")
(setq nelisp-calc-angle 'rad)
(parity-integration-check (equal (plist-get (nelisp-calc-evaluate "sin(pi/2)") :value) "1") "typed pi")
(parity-integration-check (equal (plist-get (nelisp-calc-evaluate "ln(e)") :value) "1") "typed Euler constant")
(setq nelisp-calc-angle 'grad)
(parity-integration-check (equal (plist-get (nelisp-calc-evaluate "sin(100)") :value) "1") "grad normalization")
(parity-integration-check (equal (plist-get (nelisp-calc-evaluate "arcsin(1)") :value) "100") "inverse grad normalization")
(setenv "NELISP_CALC_TARGET" (expand-file-name "target/parity-integration" nelisp-calc-root))
(setq nelisp-calc-implicit-cells 8 nelisp-calc-graph-range '("-4" "4" "-4" "4"))
(nelisp-calc-graph-token "mode:graph")
(nelisp-calc-graph-token "graph:x+y=pi")
(parity-integration-check (string-prefix-p "ok:graph:implicit:" nelisp-calc-status) "implicit pi constant")
(let ((points 0) (valid t))
  (dolist (line (cdr (split-string (parity-integration-plot) "\n" t)))
    (let ((fields (split-string line " " t)))
      (when (equal (car fields) "1")
        (let ((x (+ -4.0 (* 8.0 (/ (string-to-number (nth 1 fields)) 1000.0))))
              (y (- 4.0 (* 8.0 (/ (string-to-number (nth 2 fields)) 1000.0)))))
          ;; This analytic line is independent of the contour implementation.
          (unless (< (abs (- (+ x y) 3.141592653589793)) 0.02) (setq valid nil))
          (setq points (1+ points))))))
  (parity-integration-check (and valid (> points 0)) "implicit pi line geometry"))
(setq nelisp-calc-graph-range '("0" "100" "-2" "2"))
(nelisp-calc-graph-token "graph:sin(x)-y=0")
(parity-integration-check (string-prefix-p "ok:graph:implicit:" nelisp-calc-status) "implicit grad function")
(parity-integration-check (string-match "1 1000 250\n" (parity-integration-plot)) "sin(100 grad) reaches one")
(let ((accepted (parity-integration-plot)))
  (nelisp-calc-graph-token "graph:x+z=0")
  (parity-integration-check (equal nelisp-calc-display "ERROR") "unknown variable rejected")
  (parity-integration-check (equal (parity-integration-plot) accepted) "cross-module rollback"))
(princ (format "PARITY-INTEGRATION-PASS:%d\n" parity-integration-checks))
