;;; compat-wide-division.el --- Exact wide division contracts -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-compat.el" root) nil t)
  (nelisp-calc-compat-install root))
(dolist (item '((70710678118654000000000000000 70710678118655 999999999999985 60660171779825)
                (1000000000000000000001 1000000000000 1000000000 1)
                (-1000000000000000000001 1000000000000 -1000000000 -1)
                (1000000000000000000001 -1000000000000 -1000000000 1)
                (-1000000000000000000001 -1000000000000 1000000000 -1)
                (1000000000000000000000 1000000000000000000001 0 1000000000000000000000)))
  (let* ((a (nth 0 item)) (b (nth 1 item)) (q (/ a b)) (r (% a b)))
    (unless (and (= q (nth 2 item)) (= r (nth 3 item)) (= (+ (* q b) r) a))
      (error "Wide integer division mismatch %S: %S/%S" item q r))))
(unless (and (= (mod -1000000000000000000001 1000000000000) 999999999999)
             (= (/ 8 2 2) 2) (= (/ 8.0 2) 4.0))
  (error "Division convention regression"))
(princ "COMPAT-WIDE-DIVISION-PASS\n")
