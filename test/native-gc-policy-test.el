;;; native-gc-policy-test.el --- Dedicated initialization policy contract -*- lexical-binding: t; -*-
(require 'cl-lib)
(load (expand-file-name "../lisp/nelisp-calc-engine.el" (file-name-directory load-file-name)) nil t)
(let ((saved (getenv "NELISP_CALC_NATIVE_GC_POLICY")) (events nil) (fail nil))
  (unwind-protect
      (cl-letf (((symbol-function 'nelisp--debug-switch)
                 (lambda (selector value) (push (list selector value) events)))
                ((symbol-function 'nelisp--gc-pressure) (lambda () 0))
                ((symbol-function 'nelisp-calc-initialize)
                 (lambda () (push 'initialize events) (when fail (error "Injected initialization failure")))))
        (setenv "NELISP_CALC_NATIVE_GC_POLICY" "debt-v1")
        (nelisp-calc-initialize-owned-backend t)
        (unless (equal (reverse events) '((30 4194304) (31 100) initialize (30 0) (31 0)))
          (error "Success policy sequence: %S" events))
        (setq events nil fail t)
        (condition-case nil (nelisp-calc-initialize-owned-backend t) (error nil))
        (unless (equal (reverse events) '((30 4194304) (31 100) initialize (30 0) (31 0)))
          (error "Failure did not restore native defaults: %S" events))
        (setq events nil fail nil)
        (nelisp-calc-initialize-owned-backend nil)
        (unless (equal events '(initialize)) (error "Embedding policy changed"))
        (setq events nil)
        (setenv "NELISP_CALC_NATIVE_GC_POLICY" nil)
        (nelisp-calc-initialize-owned-backend t)
        (unless (equal events '(initialize)) (error "Missing capability changed policy"))
        (setq events nil)
        (setenv "NELISP_CALC_NATIVE_GC_POLICY" "unsupported")
        (nelisp-calc-initialize-owned-backend t)
        (unless (equal events '(initialize)) (error "Unknown capability changed policy")))
    (setenv "NELISP_CALC_NATIVE_GC_POLICY" saved)))
(princ "NATIVE-GC-POLICY-PASS:5\n")
