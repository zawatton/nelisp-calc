;;; shortcut-parity-test.el --- Genuine Calc scientific shortcut targets -*- lexical-binding: t; -*-
(load (expand-file-name "../lisp/nelisp-calc-engine.el"
                        (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t))) nil t)
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "%s" nelisp-calc-engine-error))
(defvar shortcut-parity-count 0)
(dolist (case '(("angle:grad" "eval:100" "function:sin" "1")
                ("angle:grad" "eval:1" "function:asin" "100")
                ("angle:deg" "eval:0.5" "function:asin" "30")
                ("angle:deg" "eval:0.5" "function:acos" "60")
                ("angle:deg" "eval:1" "function:atan" "45")
                ("angle:rad" "eval:0" "function:sinh" "0")
                ("angle:rad" "eval:0" "function:cosh" "1")
                ("angle:rad" "eval:0" "function:tanh" "0")
                ("angle:rad" "eval:0" "function:asinh" "0")
                ("angle:rad" "eval:1" "function:acosh" "0")
                ("angle:rad" "eval:0" "function:atanh" "0")
                ("angle:deg" "eval:3" "function:pow10" "1000")
                ("angle:deg" "eval:3" "function:pow2" "8")
                ("angle:deg" "eval:-8" "function:cuberoot" "-2")
                ("angle:deg" "eval:0" "function:pi" "3.14159265359")
                ("angle:deg" "eval:0" "function:e" "2.71828182846")))
  (nelisp-calc-token "mode:scientific")
  (dolist (token (list (nth 0 case) (nth 1 case) (nth 2 case))) (nelisp-calc-token token))
  (unless (equal nelisp-calc-display (nth 3 case))
    (error "Shortcut target %S returned %S (%s)" case nelisp-calc-display nelisp-calc-status))
  (setq shortcut-parity-count (1+ shortcut-parity-count)))
(nelisp-calc-token "angle:rad")
(dolist (case '(("sin(pi/2)" "1") ("ln(e)" "1") ("pi" "3.14159265359")))
  (unless (equal (plist-get (nelisp-calc-evaluate (car case)) :value) (cadr case))
    (error "Genuine constant expansion failed: %S" case))
  (setq shortcut-parity-count (1+ shortcut-parity-count)))
(nelisp-calc-token "angle:grad")
(dolist (case '(("sin(100)" "1") ("arcsin(sin(100))" "100") ("cos(200)" "-1")))
  (unless (equal (plist-get (nelisp-calc-evaluate (car case)) :value) (cadr case))
    (error "Grad expression failed: %S" case))
  (setq shortcut-parity-count (1+ shortcut-parity-count)))
(dolist (case '(("prog:unsigned" "17" "5" "2") ("prog:signed" "-17" "5" "-2")
                ("prog:signed" "17" "-5" "2") ("prog:unsigned" "18446744073709551615" "2" "1")))
  (dolist (token (list "mode:programmer" "prog:word:64" (nth 0 case)
                       (concat "prog:input:" (nth 1 case)) "prog:mod"
                       (concat "prog:input:" (nth 2 case)) "equals")) (nelisp-calc-token token))
  (unless (equal nelisp-calc-display (nth 3 case)) (error "Word modulo failed: %S %s" case nelisp-calc-display))
  (setq shortcut-parity-count (1+ shortcut-parity-count)))
(dolist (token '("prog:input:1" "prog:mod" "prog:input:0" "equals")) (nelisp-calc-token token))
(unless (equal nelisp-calc-display "ERROR") (error "Modulo zero must fail"))
(setq shortcut-parity-count (1+ shortcut-parity-count))
(princ (format "SHORTCUT-PARITY-PASS:%s\n" shortcut-parity-count))
