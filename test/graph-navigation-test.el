;;; graph-navigation-test.el --- Atomic viewport navigation -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-modes.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-graph.el" root) nil t))
(defvar navigation-checks 0)
(defun navigation-check (condition label)
  (unless condition (error "Navigation failed: %s; range=%S status=%s" label nelisp-calc-graph-range nelisp-calc-status))
  (setq navigation-checks (1+ navigation-checks)))
(defun navigation-file (name)
  (with-temp-buffer (insert-file-contents (expand-file-name name (file-name-directory (nelisp-calc-graph-target)))) (buffer-string)))
(defun navigation-range (expected)
  (navigation-check (equal nelisp-calc-graph-range expected) "accepted range")
  (navigation-check (equal (navigation-file "graph-range.txt") (mapconcat #'identity expected ":")) "published authoritative range"))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Calc unavailable: %s" nelisp-calc-engine-error))
(setenv "NELISP_CALC_TARGET" (expand-file-name (or (getenv "NAVIGATION_TARGET") "target/navigation-fixture") nelisp-calc-root))
(nelisp-calc-graph-token "mode:graph")
(nelisp-calc-graph-token "graph:nav:in")
(navigation-range '("-5" "5" "-5" "5"))
(navigation-check (and (equal nelisp-calc-graph-expression "x^2") (string-prefix-p "ok:graph:x^2:" nelisp-calc-status)) "navigation before first plot uses stored expression")
(navigation-check (string-match "1 500 500\n" (navigation-file "graph.txt")) "real square center")
(princ "NAVIGATION-INITIAL-PASS:4\n")
(nelisp-calc-graph-token "graph:x")
(nelisp-calc-graph-token "graph:nav:right")
(navigation-range '("-2.5" "7.5" "-5" "5"))
(navigation-check (string-match "1 250 500\n" (navigation-file "graph.txt")) "pan reprojects real x zero")
(nelisp-calc-graph-token "graph:nav:up")
(navigation-range '("-2.5" "7.5" "-2.5" "7.5"))
(navigation-check (string-match "1 500 500\n" (navigation-file "graph.txt")) "up moves viewport")
(princ "NAVIGATION-PAN-PASS:6\n")
(nelisp-calc-graph-token "graph:nav:out")
(navigation-range '("-7.5" "12.5" "-7.5" "12.5"))
(navigation-check (equal nelisp-calc-graph-expression "x") "zoom retains expression and center")
(princ "NAVIGATION-ZOOM-PASS:3\n")
(let ((range (copy-sequence nelisp-calc-graph-range)) (graph (navigation-file "graph.txt")))
  (dolist (token '("graph:range:10:-10:-10:10" "graph:range:NaN:10:-10:10"
                   "graph:range:1e999:10:-10:10" "graph:range:0:1e-999:-10:10"
                   "graph:range:(1+2):10:-10:10" "graph:range:1e20:1.00000000000001e20:-10:10"
                   "graph:range:0:1e-21:-10:10" "graph:nav:unknown"))
    (nelisp-calc-graph-token token)
    (navigation-check (and (equal nelisp-calc-display "ERROR")
                           (equal nelisp-calc-graph-range range)
                           (equal nelisp-calc-graph-expression "x")
                           (equal graph (navigation-file "graph.txt"))
                           (equal (navigation-file "graph-range.txt") (mapconcat #'identity range ":")))
                      "invalid candidate cannot poison accepted state")))
(princ "NAVIGATION-REJECTION-PASS:8\n")
(nelisp-calc-graph-token "graph:nav:reset")
(navigation-range '("-10" "10" "-10" "10"))
(navigation-check (string-match "1 500 500\n" (navigation-file "graph.txt")) "reset renders retained x")
(nelisp-calc-graph-token "graph:nav:left")
(nelisp-calc-graph-token "graph:nav:down")
(navigation-range '("-15" "5" "-15" "5"))
(navigation-check (and (equal nelisp-calc-graph-expression "x") (string-match "1 750 250\n" (navigation-file "graph.txt"))) "left down quarter span")
(princ "NAVIGATION-RESET-PASS:6\n")
(setq nelisp-calc-mode 'standard)
(navigation-check (not (nelisp-calc-graph-token "graph:nav:in")) "other mode untouched")
(princ (format "NAVIGATION-PASS:%d\n" navigation-checks))
