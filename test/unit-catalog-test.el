;;; unit-catalog-test.el --- Genuine Calc conversion checks -*- lexical-binding: t; -*-
(let ((root (or (getenv "UNIT_CATALOG_ROOT")
                (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t))))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-modes.el" root) nil t))
(defvar unit-checks 0)
(defvar unit-focused (getenv "UNIT_CATALOG_FOCUSED"))
(defvar unit-shard (getenv "UNIT_CATALOG_SHARD"))
(defvar unit-offset (if (getenv "UNIT_CATALOG_OFFSET") (string-to-number (getenv "UNIT_CATALOG_OFFSET")) 0))
(defvar unit-limit (if (getenv "UNIT_CATALOG_LIMIT") (string-to-number (getenv "UNIT_CATALOG_LIMIT")) 0))
(defvar unit-id "catalog/uk-gallon")
(defun unit-assert (condition label)
  (unless condition (error "Unit catalog failure: %s" label))
  (when (getenv "UNIT_CATALOG_TRACE")
    (write-region (concat unit-id "\tPASS\n") nil (getenv "UNIT_CATALOG_TRACE") t 'silent))
  (setq unit-checks (1+ unit-checks)))
;; This first condition is deliberately red on the preserved old catalog.
(when (or (not unit-shard) (equal unit-shard "global"))
  (unit-assert (assq 'galuk (cdr (assq 'volume nelisp-calc-convert-categories))) "missing UK gallon"))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Genuine Calc unavailable: %s" nelisp-calc-engine-error))
(defun unit-value (category from to amount)
  (setq nelisp-calc-convert-category category nelisp-calc-convert-from from
        nelisp-calc-convert-to to nelisp-calc-modes-input amount)
  (nelisp-calc-convert)
  nelisp-calc-display)
(defun unit-check (category from to amount expected)
  (let* ((actual (unit-value category from to amount))
         (comparison (if (equal actual expected) (list :ok t :value "1")
                       (nelisp-calc-evaluate (if (equal expected "0") (format "abs(%s) <= 1e-20" actual)
                                              (format "abs(((%s)-(%s))/(%s)) <= 1e-10" actual expected expected))))))
    (unit-assert (and (plist-get comparison :ok) (equal (plist-get comparison :value) "1"))
                 (format "%s %s/%s %s expected %s got %s" category from to amount expected actual))))
(when (getenv "UNIT_CATALOG_SINGLE")
  (setq unit-id "known/10")
  (unit-check 'data 'yib 'byte "1" "1208925819614629174706176")
  (setq unit-id "edge/yib-inverse")
  (unit-check 'data 'byte 'yib "1208925819614629174706176" "1")
  (setq unit-id "edge/gibit")
  (unit-check 'data 'gibit 'bit "1" "1073741824")
  (princ (format "UNIT-CATALOG-PASS:%d largest-data\n" unit-checks))
  (kill-emacs 0))
;; Independent dimensional values; do not derive expectations from the catalog.
(when (or (not unit-shard) (equal unit-shard "global"))
(let ((index 0))
(dolist (case '((volume galuk l "1" "4.54609") (volume galus l "1" "3.785411784")
                (volume tspus ml "1" "4.92892159375") (volume m3 l "1" "1000")
                (mass longton lb "1" "2240") (mass shortton lb "1" "2000")
                (mass carat g "1" "0.2") (mass stone lb "1" "14")
                (data mib kib "1" "1024") (data mb kb "1" "1000")
                (data yib byte "1" "1208925819614629174706176") (data kibit bit "1" "1024")
                (data nibble bit "1" "4") (angle grad deg "100" "90") (angle rad deg "3.141592653589793" "180")
                (temp c f "-40" "-40") (temp k c "273.15" "0") (temp f k "32" "273.15")
                (length angstrom m "1" "1e-10") (area pyeong m2 "121" "400")
                (energy kcal j "1" "4184") (energy ev j "1e20" "16.02176565")
                (speed mach mps "1" "340.3") (speed knot mps "1" "0.5144")
                (time year day "1" "365.25") (time us s "1000000" "1")
                (power btumin w "60" "1055.056") (pressure atm pa "1" "101325")))
  (setq unit-id (format "known/%d" index) index (1+ index))
  (apply #'unit-check case))))
(princ (format "UNIT-KNOWN-PASS:%d\n" unit-checks))
;; Every selectable unit must execute through Calc, preserve identity and invert.
(dolist (category nelisp-calc-convert-categories)
  (when (or (not unit-shard) (equal unit-shard (symbol-name (car category))))
  (let ((base (car (cadr category))))
    (dolist (unit (if (> unit-limit 0)
                     (let ((tail (nthcdr unit-offset (cdr category))) (selected nil) (count 0))
                       (while (and tail (< count unit-limit))
                         (setq selected (append selected (list (car tail))) tail (cdr tail) count (1+ count)))
                       selected)
                   (if unit-focused
                     (list (if (eq (car category) 'data) (assq 'mib (cdr category)) (car (last (cdr category)))))
                   (cdr category))))
      (setq unit-id (format "identity/%s/%s" (car category) (car unit)))
      (unit-check (car category) (car unit) (car unit) "1.25" "1.25")
      (let ((forward (unit-value (car category) (car unit) base "125")))
        (setq unit-id (format "inverse/%s/%s" (car category) (car unit)))
        (unit-check (car category) base (car unit) forward "125"))))
  (princ (format "UNIT-CATEGORY-PASS:%s\n" (car category)))))
(when (or (not unit-shard) (equal unit-shard "global"))
(setq unit-id "edge/large")
(unit-check 'length 'km 'nm "1e30" "1e42")
(setq unit-id "edge/small")
(unit-check 'length 'angstrom 'km "1e-30" "1e-43")
(dolist (unit '(yb ybit yib yibit))
  (setq unit-id (format "edge/data-identity/%s" unit))
  (unit-check 'data unit unit "1" "1"))
(setq unit-id "edge/yib-inverse")
(unit-check 'data 'byte 'yib "1208925819614629174706176" "1")
(setq unit-id "edge/gibit")
(unit-check 'data 'gibit 'bit "1" "1073741824")
(dolist (bad '((length kg m) (volume missing l) (unknown m m)))
  (setq unit-id (format "reject/%s/%s/%s" (car bad) (cadr bad) (nth 2 bad)))
  (let ((failed nil))
    (condition-case nil (unit-value (car bad) (cadr bad) (nth 2 bad) "1") (error (setq failed t)))
    (unit-assert failed "invalid unit/category accepted"))))
(princ (format "UNIT-CATALOG-PASS:%d categories=%d units=%d\n" unit-checks (length nelisp-calc-convert-categories)
               (apply #'+ (mapcar (lambda (c) (length (cdr c))) nelisp-calc-convert-categories))))
