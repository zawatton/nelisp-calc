;;; implicit-graph-test.el --- Genuine Calc contour acceptance -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-modes.el" root) nil t)
  (load (expand-file-name "lisp/nelisp-calc-graph.el" root) nil t))
(defvar implicit-checks 0)
(defun implicit-check (condition label)
  (unless condition (error "Implicit check: %s; %s" label nelisp-calc-status))
  (setq implicit-checks (1+ implicit-checks)))
(defun implicit-file ()
  (with-temp-buffer (insert-file-contents (nelisp-calc-graph-target)) (buffer-string)))
(defun implicit-points ()
  (let (points)
    (dolist (line (split-string (implicit-file) "\n" t))
      (when (string-match "\\`1 \\([0-9]+\\) \\([0-9]+\\)\\'" line)
        (setq points (cons (list (string-to-number (match-string 1 line))
                                 (string-to-number (match-string 2 line))) points))))
    points))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Calc unavailable: %s" nelisp-calc-engine-error))
(setenv "NELISP_CALC_TARGET" (expand-file-name "target/implicit-fixture" nelisp-calc-root))
(nelisp-calc-graph-token "mode:graph")
(nelisp-calc-graph-token "graph:x^2+y^2=25")
(implicit-check (string-prefix-p "ok:graph:implicit:" nelisp-calc-status) "circle evaluates")
(let ((points (implicit-points)) (xmin 1000) (xmax 0) (ymin 1000) (ymax 0) (bad 0) (incidence nil) (open nil))
  (dolist (point points)
    (let* ((px (car point)) (py (cadr point))
           (x (- (/ px 50.0) 10)) (y (- 10 (/ py 50.0))))
      (setq xmin (min xmin px) xmax (max xmax px) ymin (min ymin py) ymax (max ymax py))
      (let ((entry (assoc point incidence)))
        (if entry (setcdr entry (1+ (cdr entry)))
          (setq incidence (cons (cons point 1) incidence))))
      (when (> (abs (- (+ (* x x) (* y y)) 25)) 1.0) (setq bad (1+ bad)))))
  (dolist (entry incidence) (unless (= (% (cdr entry) 2) 0) (setq open t)))
  (implicit-check (and (> (length points) 70) (not open)) "circle contour closed at every segment endpoint")
  (implicit-check (and (= xmin 250) (= xmax 750) (= ymin 250) (= ymax 750)) "circle extents")
  (implicit-check (= bad 0) "circle residual under grid tolerance")
  (let ((rejected nil) (nelisp-calc-implicit-cells 25))
    (condition-case nil (nelisp-calc-implicit-render "x+y") (error (setq rejected t)))
    (implicit-check (and rejected (<= (length (split-string (implicit-file) "\n" t)) 2048)) "grid and protocol capacity")))
(when (getenv "NELISP_CALC_IMPLICIT_FOCUS")
  (princ (format "IMPLICIT-FOCUS-PASS:%d\n" implicit-checks))
  (kill-emacs 0))
(nelisp-calc-graph-token "graph:x*y=1")
(implicit-check (string-prefix-p "ok:graph:implicit:" nelisp-calc-status) "hyperbola evaluates")
(implicit-check (> (length (implicit-points)) 30) "hyperbola visible")
(let ((lines (split-string (implicit-file) "\n" t)) previous (bad 0))
  (dolist (line lines)
    (if (equal line "0 0 0") (setq previous nil)
      (when (string-match "\\`1 \\([0-9]+\\) \\([0-9]+\\)\\'" line)
        (let ((point (string-to-number (match-string 1 line))))
          (when (and previous (< (* (- previous 500) (- point 500)) 0))
            (setq bad (1+ bad)))
          (setq previous point)))))
  (implicit-check (= bad 0) "hyperbola branches never connected across pole"))
(let ((snapshot (implicit-file)) (expression nelisp-calc-graph-expression)
      (range nelisp-calc-graph-range))
  (dolist (bad '("graph:x+z=1" "graph:badfun(x)+y=0" "graph:x=y=1" "graph:x-x+y-y=0"))
    (nelisp-calc-graph-token bad)
    (implicit-check (equal nelisp-calc-display "ERROR") bad)
    (implicit-check (and (equal snapshot (implicit-file))
                         (equal expression nelisp-calc-graph-expression)
                         (equal range nelisp-calc-graph-range)) "failure rolls back")))
(nelisp-calc-graph-token "graph:x^2+y^2=10000")
(implicit-check (and (string-prefix-p "ok:graph:implicit:" nelisp-calc-status)
                     (equal (implicit-file) "SCG1\n")) "empty valid contour")
(nelisp-calc-graph-token "graph:x^2")
(implicit-check (string-prefix-p "ok:graph:x^2:" nelisp-calc-status) "explicit square retained")
(let ((snapshot (implicit-file)))
  (nelisp-calc-graph-token "graph:y=x^2")
  (implicit-check (equal snapshot (implicit-file)) "explicit y equation retained"))
(nelisp-calc-graph-token "graph:x^2+y^2=25")
(nelisp-calc-graph-token "graph:zoom:1")
(implicit-check (string-prefix-p "ok:graph:implicit:" nelisp-calc-status) "implicit zoom")
(nelisp-calc-graph-token "graph:shift:200:0")
(implicit-check (string-prefix-p "ok:graph:implicit:" nelisp-calc-status) "implicit pan")
(princ (format "IMPLICIT-PASS:%d\n" implicit-checks))
