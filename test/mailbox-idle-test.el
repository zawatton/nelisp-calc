;;; mailbox-idle-test.el --- Focused mailbox protocol checks -*- lexical-binding: t; -*-

;; Load only definitions: the production entry remains unconditional.
(let ((source (or (getenv "MAILBOX_TEST_SOURCE")
                  (expand-file-name "../lisp/nelisp-calc-mailbox.el"
                                    (file-name-directory load-file-name)))))
  (with-temp-buffer
    (insert-file-contents source)
    (goto-char (point-min))
    (condition-case nil
        (while t
          (let ((form (read (current-buffer))))
            (when (memq (car-safe form) '(defvar defun)) (eval form))))
      (end-of-file nil))))

(defvar mailbox-test-reads 0)
(defvar mailbox-test-tokens nil)
(defvar mailbox-test-responses 0)
(defvar mailbox-test-insert (symbol-function 'insert-file-contents))
(defvar mailbox-test-attributes (symbol-function 'file-attributes))
(defvar mailbox-test-race nil)
(defvar mailbox-test-publish (symbol-function 'nelisp-calc-write-response))
(defvar mailbox-test-assertions 0)
(defun mailbox-test-assert (condition label)
  (unless condition (error "Mailbox assertion failed: %s" label))
  (setq mailbox-test-assertions (1+ mailbox-test-assertions)))
(defun mailbox-test-append (text)
  (with-temp-buffer
    (insert text)
    (write-region (point-min) (point-max)
                  (expand-file-name "requests.txt" nelisp-calc-target) t 'silent)))
(fset 'insert-file-contents
      (lambda (&rest args)
        (setq mailbox-test-reads (1+ mailbox-test-reads))
        (apply mailbox-test-insert args)))
(fset 'nelisp-calc-token
      (lambda (token)
        (setq mailbox-test-tokens (cons token mailbox-test-tokens))
        (when (equal token "bad") (error "Expected token failure"))))
(fset 'nelisp-calc-write-response
      (lambda () (setq mailbox-test-responses (1+ mailbox-test-responses))))
(setq nelisp-calc-target (getenv "NELISP_CALC_TARGET"))
(make-directory nelisp-calc-target t)
(nelisp-calc-poll)
(mailbox-test-append "")
(nelisp-calc-poll)
(mailbox-test-assert (= mailbox-test-reads 0) "absent and empty avoid read")
(mailbox-test-append "one\npartial")
(fset 'insert-file-contents (lambda (&rest _) (signal 'file-error '("Expected read failure"))))
(let ((rejected nil))
  (condition-case nil (nelisp-calc-poll) (file-error (setq rejected t)))
  (mailbox-test-assert (and rejected (= nelisp-calc-request-size 0)
                            (= nelisp-calc-request-count 0)) "failed read preserves cache"))
(fset 'insert-file-contents
      (lambda (&rest args)
        (setq mailbox-test-reads (1+ mailbox-test-reads))
        (apply mailbox-test-insert args)))
(nelisp-calc-poll)
(mailbox-test-assert (= nelisp-calc-request-count 1) "partial pending")
(dotimes (_ 20) (nelisp-calc-poll))
(mailbox-test-assert (= mailbox-test-reads 1) "unchanged skips buffer/read/scan")
(mailbox-test-append "-done\r\nbad\n")
(nelisp-calc-poll)
(mailbox-test-assert (equal (reverse mailbox-test-tokens)
                            '("one" "partial-done" "bad")) "CRLF and error once")
(mailbox-test-assert (= mailbox-test-responses 3) "error acknowledged")
;; Append after metadata sampling, before the read.  The next poll may reread
;; but must never replay tokens or suppress an unread append.
(fset 'file-attributes
      (lambda (&rest args)
        (let ((snapshot (apply mailbox-test-attributes args)))
          (when mailbox-test-race
            (setq mailbox-test-race nil)
            (mailbox-test-append "race\n"))
          snapshot)))
(mailbox-test-append "before\n")
(setq mailbox-test-race t)
(nelisp-calc-poll)
(nelisp-calc-poll)
(mailbox-test-assert (= nelisp-calc-request-count 5) "racing append counted once")
(mailbox-test-assert (= (length mailbox-test-tokens) 5) "no token replay")
(let ((reads mailbox-test-reads))
  (nelisp-calc-poll)
  (mailbox-test-assert (= reads mailbox-test-reads) "settled race skips read"))
(with-temp-buffer
  (write-region (point-min) (point-max)
                (expand-file-name "requests.txt" nelisp-calc-target) nil 'silent))
(let ((rejected nil))
  (condition-case nil (nelisp-calc-poll) (error (setq rejected t)))
  (mailbox-test-assert rejected "truncation rejected"))
(defvar nelisp-process-adapter--live nil)
(defvar nelisp-async-core--timers nil)
(defvar mailbox-test-sleeps 0)
(defvar mailbox-test-pumps 0)
(fset 'nelisp-async-core--nanosleep
      (lambda (seconds)
        (mailbox-test-assert (= seconds 0.1) "same idle interval")
        (setq mailbox-test-sleeps (1+ mailbox-test-sleeps))))
(fset 'accept-process-output
      (lambda (&rest _) (setq mailbox-test-pumps (1+ mailbox-test-pumps))))
(nelisp-calc-idle-wait)
(setq nelisp-process-adapter--live '(registered))
(nelisp-calc-idle-wait)
(setq nelisp-process-adapter--live nil nelisp-async-core--timers '(pending))
(nelisp-calc-idle-wait)
(mailbox-test-assert (and (= mailbox-test-sleeps 1) (= mailbox-test-pumps 2))
                     "live process and timer always pump")
(defvar mailbox-test-renames 0)
(defvar mailbox-test-rename (symbol-function 'rename-file))
(fset 'rename-file
      (lambda (&rest args)
        (setq mailbox-test-renames (1+ mailbox-test-renames))
        (if (< mailbox-test-renames 3) (signal 'file-error '("Expected sharing failure"))
          (apply mailbox-test-rename args))))
(setq nelisp-calc-display "5" nelisp-calc-status "ready")
(funcall mailbox-test-publish)
(mailbox-test-assert (and (= mailbox-test-renames 3)
                          (= (length mailbox-test-tokens) 5)) "publish retry never replays")
(princ (format "MAILBOX-IDLE-PASS:%d\n" mailbox-test-assertions))
