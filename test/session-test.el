;;; session-test.el --- Genuine Calc session and signed word checks -*- lexical-binding: t; -*-
(let ((root (expand-file-name ".." (file-name-directory (replace-regexp-in-string "\\\\" "/" load-file-name t t)))))
  (load (expand-file-name "lisp/nelisp-calc-engine.el" root) nil t))
(defvar session-checks 0)
(defun session-check (test name)
  (unless test (error "%s: display=%s status=%s" name nelisp-calc-display nelisp-calc-status))
  (setq session-checks (1+ session-checks)))
(defun session-tokens (tokens) (dolist (token tokens) (nelisp-calc-token token)))
(defun session-value (expected tokens)
  (session-tokens tokens) (session-check (equal expected nelisp-calc-display) (format "%S" tokens)))
(setenv "NELISP_CALC_TARGET" (expand-file-name "target/session-fixture-a" nelisp-calc-root))
(nelisp-calc-initialize)
(when nelisp-calc-engine-error (error "Calc unavailable: %s" nelisp-calc-engine-error))
(session-tokens '("eval:0.1" "memory:store"))
(session-check (equal nelisp-calc-session-memory "0.1") "MS exact decimal")
(session-value "0.1" '("clear" "memory:recall"))
(session-tokens '("eval:0.2" "memory:add" "memory:recall"))
(session-check (equal nelisp-calc-display "0.3") "M+ genuine Calc")
(session-tokens '("eval:0.1" "memory:sub" "memory:recall"))
(session-check (equal nelisp-calc-display "0.2") "M- genuine Calc")
(session-check (= (length nelisp-calc-session-history) 3) "memory helpers do not enter history")
(session-tokens '("memory:clear"))
(session-check (null nelisp-calc-session-memory) "MC")
(session-tokens '("memory:recall"))
(session-check (equal nelisp-calc-display "ERROR") "empty MR explicit")
(session-tokens '("history:clear" "clear" "2" "add" "3" "equals"))
(session-check (equal (car nelisp-calc-session-history) '("2 + 3" . "5")) "meaningful standard expression")
(session-value "5" '("clear" "history:recall:0"))
(session-check (= (length nelisp-calc-session-history) 1) "history recall not duplicated")
(session-tokens '("mode:scientific" "eval:9" "function:sqrt"))
(session-check (equal (car nelisp-calc-session-history) '("sqrt(9)" . "3")) "unary input preserved")
(session-tokens '("history:clear" "mode:graph"))
(session-check (null (nelisp-calc-session-context "eval:x^2")) "graph user intent excluded from numeric history")
(nelisp-calc-graph-render)
(session-check (null nelisp-calc-session-history) "101 internal graph Calc samples not recorded")
(session-tokens '("mode:standard" "eval:4" "memory:store"))
(let ((original nelisp-calc-session-directory))
  (setenv "NELISP_CALC_TARGET" (expand-file-name "target/session-fixture-b" nelisp-calc-root))
  (nelisp-calc-session-ensure)
  (session-check (and (null nelisp-calc-session-memory) (null nelisp-calc-session-history)) "new instance empty")
  (session-check (file-exists-p (expand-file-name "memory.txt" original)) "original instance snapshot retained"))
(session-tokens '("mode:standard"))
(nelisp-calc-token "eval:1+1")
;; Exercise retention with the real record hook and the genuine Calc result;
;; repeating identical Calc evaluations would not strengthen this bound check.
(let ((i 0))
  (while (< i 104) (nelisp-calc-session-record "1+1") (setq i (1+ i))))
(session-check (= (length nelisp-calc-session-history) 100) "history bound100")
(with-temp-buffer
  (insert-file-contents (expand-file-name "history.txt" nelisp-calc-session-directory))
  (session-check (and (string-prefix-p "0\t1+1\t2\n" (buffer-string)) (= (length (split-string (buffer-string) "\n" t)) 100)) "atomic UI history snapshot"))
(session-tokens '("history:clear"))
(session-check (null nelisp-calc-session-history) "history clear")
(session-value "-1" '("mode:programmer" "clear" "prog:signed" "prog:not"))
(session-value "FFFFFFFFFFFFFFFF" '("prog:base:hex"))
(session-value "-1" '("prog:base:dec" "prog:shr"))
(session-value "18446744073709551615" '("prog:unsigned"))
(session-value "9223372036854775807" '("prog:shr"))
(session-value "-3" '("prog:signed" "clear" "7" "sign" "div" "2" "equals"))
(session-value "3" '("clear" "7" "sign" "div" "2" "sign" "equals"))
(session-value "-128" '("clear" "prog:word:8" "1" "2" "8" "add" "0" "equals"))
(session-value "-128" '("prog:word:64"))
(session-value "-9223372036854775808" '("prog:input:-9223372036854775808"))
(session-value "-4611686018427387904" '("prog:shr"))
(session-value "-9223372036854775808" '("prog:input:-9223372036854775808" "div" "prog:input:-1" "equals"))
(session-value "ERROR" '("prog:input:1+2"))
(session-value "ERROR" '("memory:store"))
(session-value "-1.5" '("mode:convert" "convert:category:length" "convert:from:m" "convert:to:m" "convert:input:-1.5"))
(session-value "-1.5" '("equals"))
(session-value "ERROR" '("convert:input:1+2"))
(session-value "1609.344" '("mode:convert" "convert:category:length" "convert:from:mi" "convert:to:m" "1" "equals"))
(session-value "4.184" '("clear" "convert:category:energy" "convert:from:cal" "convert:to:j" "1" "equals"))
(session-value "1073741824" '("clear" "convert:category:data" "convert:from:gib" "convert:to:byte" "1" "equals"))
(let ((rates (expand-file-name "FIXTURE-rates.tsv" nelisp-calc-session-directory)))
  (with-temp-file rates (insert "date=2026-10-28\nEUR\t1\nUSD\t2\n"))
  (setenv "NELISP_CALC_RATES" rates) (setenv "NELISP_CALC_TODAY" "2026-10-28")
  (session-value "1.25" '("mode:currency" "currency:input:1.25"))
  (session-value "2.5" '("equals"))
  (session-value "ERROR" '("currency:input:1+2")))
;; Keep all 41 original checks above; exercise independent selected values.
(session-tokens '("mode:standard" "memory:clear" "history:clear" "eval:0.1" "memory:store" "eval:7" "memory:store"))
(session-check (equal nelisp-calc-session-memories '("7" "0.1")) "MS pushes newest")
(session-check (= nelisp-calc-session-memory-index 0) "MS selects newest")
(session-tokens '("memory:select:1"))
(session-check (equal nelisp-calc-session-memory "0.1") "select older")
(session-value "0.1" '("clear" "memory:recall"))
(session-tokens '("eval:0.2" "memory:add"))
(session-check (equal nelisp-calc-session-memories '("7" "0.3")) "M+ selected only")
(session-tokens '("eval:0.1" "memory:sub"))
(session-check (equal nelisp-calc-session-memories '("7" "0.2")) "M- selected only")
(session-tokens '("memory:select:0"))
(session-value "7" '("clear" "memory:recall"))
(session-check (= (length nelisp-calc-session-history) 4) "memory selection and updates do not enter history")
(dolist (token '("memory:select:" "memory:select:-1" "memory:select:x" "memory:select:1x" "memory:select:99" "memory:select:10000000000000000000000000000000000000000"))
  (session-tokens (list token))
  (session-check (and (equal nelisp-calc-session-memories '("7" "0.2"))
                      (= nelisp-calc-session-memory-index 0) (equal nelisp-calc-session-memory "7")
                      (equal nelisp-calc-display "ERROR")) token))
(session-tokens '("memory:select:1" "eval:sqrt(-1)" "memory:store"))
(session-check (and (equal nelisp-calc-session-memories '("7" "0.2")) (= nelisp-calc-session-memory-index 1)) "nonreal failure atomic")
(session-tokens '("memory:remove"))
(session-check (and (equal nelisp-calc-session-memories '("7")) (= nelisp-calc-session-memory-index 0)) "remove selected tail selects neighbor")
(session-tokens '("eval:8" "memory:store" "eval:9" "memory:store" "memory:select:1" "memory:remove"))
(session-check (and (equal nelisp-calc-session-memories '("9" "7")) (equal nelisp-calc-session-memory "7")) "remove middle preserves order")
(with-temp-buffer
  (insert-file-contents (expand-file-name "memories.txt" nelisp-calc-session-directory))
  (session-check (equal (buffer-string) "0\t9\n1\t7\n") "memory dropdown snapshot"))
(with-temp-buffer
  (insert-file-contents (expand-file-name "memory.txt" nelisp-calc-session-directory))
  (session-check (equal (buffer-string) "7\n") "legacy selected snapshot"))
(session-tokens '("memory:clear"))
(session-check (and (null nelisp-calc-session-memories) (null nelisp-calc-session-memory-index)) "legacy MC clears all")
(session-tokens '("eval:2" "memory:sub"))
(session-check (equal nelisp-calc-session-memories '("-2")) "M- creates from zero when empty")
(session-tokens '("memory:remove"))
(session-check (and (null nelisp-calc-session-memory) (null nelisp-calc-session-memory-index)) "remove last leaves empty")
(session-tokens '("memory:remove"))
(session-check (and (null nelisp-calc-session-memories) (equal nelisp-calc-display "ERROR")) "remove empty explicit")
(session-tokens '("eval:1" "memory:add"))
(session-check (equal nelisp-calc-session-memories '("1")) "M+ creates from zero when empty")
;; Fill the collection without repeating identical genuine Calc evaluations.
(let ((i 1))
  (while (< i 100) (setq nelisp-calc-session-memories (cons "1" nelisp-calc-session-memories) i (1+ i))))
(session-tokens '("eval:2" "memory:store"))
(session-check (and (= (length nelisp-calc-session-memories) 100) (equal nelisp-calc-session-memory "1")
                    (= nelisp-calc-session-memory-index 0) (equal nelisp-calc-display "ERROR")) "full memory rejects without eviction")
(session-tokens '("memory:select:99" "eval:2" "memory:add"))
(session-check (and (= (length nelisp-calc-session-memories) 100) (equal nelisp-calc-session-memory "3")) "full memory permits selected update")
(setenv "NELISP_CALC_TARGET" (expand-file-name "target/session-fixture-c" nelisp-calc-root))
(nelisp-calc-session-ensure)
(session-check (and (null nelisp-calc-session-memories) (null nelisp-calc-session-memory-index)
                    (null nelisp-calc-session-memory) (null nelisp-calc-session-history)) "multiple memory session isolation")
(princ (format "SESSION-PASS:%d\n" session-checks))
