;;; navigation.el --- Discoverable native access panels -*- lexical-binding: t; -*-

(defun calc-navigation-controls (program)
  "Generate persistent navigation and mutually exclusive native revealers.
Context slots 6504..6704 belong to navigation; 6600/6608 hold Copy/Paste."
  (let (forms dispatch)
    (cl-labels ((blob (name text) (push `(data-blob ,name ,(concat text "\0") rodata) forms)))
      (dolist (row '((navigation_close "Close panel") (navigation_title "Standard")
                     (navigation_file "navigation-native.tsv")
                     (navigation_format "%s\t%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%ld\t%s\t%s\t%ld\t%ld\t%ld\t%ld\t%ld\t%ld\n")))
        (blob (car row) (cadr row)))
      (push '(defun navigation_close_all (ctx)
               (seq (extern-call gtk_revealer_set_reveal_child (ptr-read-u64 ctx 6504) 0)
                    (extern-call gtk_revealer_set_reveal_child (ptr-read-u64 ctx 6512) 0)
                    (extern-call gtk_revealer_set_reveal_child (ptr-read-u64 ctx 6520) 0)
                    (extern-call gtk_revealer_set_reveal_child (ptr-read-u64 ctx 6528) 0)
                    (ptr-write-u64 ctx 6584 0) 0)) forms)
      (push '(defun on_navigation_close (widget ctx)
               (seq (navigation_close_all ctx)
                    (extern-call gtk_widget_grab_focus (ptr-read-u64 ctx (ptr-read-u64 ctx 6592))) 0)) forms)
      (push '(defun navigation_mode_changed (ctx)
               (seq (extern-call gtk_label_set_text (ptr-read-u64 ctx 6536) (ptr-read-u64 ctx 216))
                    (navigation_close_all ctx) (apply_mode_window ctx) (ptr-write-u64 ctx 6592 6544)
                    (if (= (shortcut_editable_focus ctx) 1) 0
                      (extern-call gtk_widget_grab_focus (ptr-read-u64 ctx 8))) 0)) forms)
      (push '(defun navigation_panel (ctx child offset)
               (let ((panel (extern-call gtk_revealer_new))
                     (box (extern-call gtk_box_new 1 4))
                     (close (extern-call gtk_button_new_with_label (data-addr navigation_close))))
                 (seq (ptr-write-u64 ctx offset panel)
                      (ptr-write-u64 ctx (+ 6624 (- offset 6504)) close)
                      (extern-call gtk_revealer_set_transition_duration panel 0)
                      (extern-call gtk_widget_set_tooltip_text close (data-addr navigation_close))
                      (extern-call g_signal_connect_data close (data-addr clicked) (addr-of on_navigation_close) ctx 0 0)
                      (extern-call gtk_box_append box close) (extern-call gtk_box_append box child)
                      (extern-call gtk_revealer_set_child panel box) panel))) forms)
      (let (buttons)
        (cl-loop for (label panel slot focus) in '(("Menu" 6504 6544 3280) ("History" 6512 6552 3240)
                                                  ("Memory" 6520 6560 3680) ("Settings" 6528 6568 3528))
                 for i from 0
                 for id = (intern (format "navigation_label_%d" i))
                 for token = (intern (format "navigation_token_%d" i))
                 for callback = (intern (format "on_navigation_%d" i)) do
                 (blob id label) (blob token (concat "ui:nav:" (nth i '("menu" "history" "memory" "settings"))))
                 (push `(defun ,callback (widget ctx)
                          (let ((open (extern-call gtk_revealer_get_reveal_child (ptr-read-u64 ctx ,panel))))
                            (seq (navigation_close_all ctx) (ptr-write-u64 ctx 6592 ,slot)
                                 (if (= open 1) (extern-call gtk_widget_grab_focus widget)
                                   (seq (extern-call gtk_revealer_set_reveal_child (ptr-read-u64 ctx ,panel) 1)
                                        (ptr-write-u64 ctx 6584 ,panel)
                                        (extern-call gtk_widget_grab_focus (ptr-read-u64 ctx ,(+ 6624 (- panel 6504)))))) 0))) forms)
                 (push `(let ((button (extern-call gtk_button_new_with_label (data-addr ,id))))
                          (seq (ptr-write-u64 ctx ,slot button)
                               (extern-call gtk_widget_set_tooltip_text button (data-addr ,id))
                               (extern-call g_signal_connect_data button (data-addr clicked) (addr-of ,callback) ctx 0 0)
                               (extern-call gtk_box_append header button)
                               0)) buttons)
                 (push `(if (= (extern-call strcmp command (data-addr ,token)) 0)
                            (seq (extern-call g_signal_emit_by_name (ptr-read-u64 ctx ,slot) (data-addr clicked)) 1) NEXT) dispatch))
        (push `(defun setup_navigation (ctx tabs)
                 (let ((outer (extern-call gtk_box_new 1 4)) (header (extern-call gtk_box_new 0 4))
                       (caption (extern-call gtk_label_new (data-addr navigation_title))))
                   (seq (ptr-write-u64 ctx 6536 caption) (ptr-write-u64 ctx 6656 header)
                        (ptr-write-u64 ctx 6592 6544)
                        (extern-call gtk_widget_set_hexpand caption 1)
                        (extern-call gtk_label_set_xalign caption (:f64 0.0))
                        ,@(nreverse buttons)
                        (extern-call gtk_box_append outer header)
                        (extern-call gtk_box_append outer caption)
                        (navigation_panel ctx tabs 6504) outer))) forms))
      (push `(defun navigation_body (ctx body)
               (let ((overlay (extern-call gtk_overlay_new)))
                 (seq (ptr-write-u64 ctx 6664 overlay)
                      (extern-call gtk_overlay_set_child overlay body)
                      ,@(cl-loop for offset in '(6504 6512 6520 6528) append
                                 `((extern-call gtk_widget_set_halign (ptr-read-u64 ctx ,offset) ,(if (= offset 6504) 1 2))
                                   (extern-call gtk_widget_set_valign (ptr-read-u64 ctx ,offset) 1)
                                   (extern-call gtk_overlay_add_overlay overlay (ptr-read-u64 ctx ,offset))
                                   (extern-call gtk_overlay_set_measure_overlay overlay (ptr-read-u64 ctx ,offset) 0))) overlay))) forms)
      (blob 'navigation_close_command "ui:nav:close")
      (blob 'navigation_snapshot_command "ui:nav:snapshot")
      (cl-loop for mode in '("standard" "scientific" "programmer" "convert" "date" "graph" "currency")
               for i from 0 for id = (intern (format "navigation_choice_%d" i)) do
               (blob id (concat "nav:mode:" mode))
               (push `(if (= (extern-call strcmp command (data-addr ,id)) 0)
                          (seq (if (= (extern-call gtk_revealer_get_reveal_child (ptr-read-u64 ctx 6504)) 1)
                                 (emit_command ctx (data-addr ,(intern (format "advanced_plain_%d" i)))) 0) 1) NEXT) dispatch))
      (push '(defun navigation_snapshot (ctx command)
               (let ((fp (extern-call fopen (data-addr navigation_file) (data-addr append_mode))))
                 (if (= fp 0) 0
                   (seq (extern-call gtk_widget_measure (extern-call gtk_window_get_child (ptr-read-u64 ctx 3288))
                            0 -1 (+ ctx 6672) (+ ctx 6676) (+ ctx 6680) (+ ctx 6684))
                        (extern-call gtk_widget_measure (extern-call gtk_window_get_child (ptr-read-u64 ctx 3288))
                            1 -1 (+ ctx 6688) (+ ctx 6692) (+ ctx 6696) (+ ctx 6700))
                        (extern-call fprintf fp (data-addr navigation_format) command
                          (extern-call gtk_label_get_text (ptr-read-u64 ctx 6536))
                          (ptr-read-u64 ctx 6584)
                          (extern-call gtk_revealer_get_reveal_child (ptr-read-u64 ctx 6504))
                          (extern-call gtk_revealer_get_reveal_child (ptr-read-u64 ctx 6512))
                          (extern-call gtk_revealer_get_reveal_child (ptr-read-u64 ctx 6520))
                          (extern-call gtk_revealer_get_reveal_child (ptr-read-u64 ctx 6528))
                          (ptr-read-u64 ctx 3296)
                          (extern-call gtk_editable_get_text (ptr-read-u64 ctx 184)) (ptr-read-u64 ctx 16)
                          (navigation_structure ctx)
                          (if (= (ptr-read-u64 ctx 6584) 0)
                            (= (extern-call gtk_window_get_focus (ptr-read-u64 ctx 3288))
                               (ptr-read-u64 ctx (ptr-read-u64 ctx 6592)))
                            (extern-call gtk_widget_is_ancestor (extern-call gtk_window_get_focus (ptr-read-u64 ctx 3288))
                              (ptr-read-u64 ctx (ptr-read-u64 ctx 6584))))
                          (logand (ptr-read-u64 ctx 6672) 4294967295) (logand (ptr-read-u64 ctx 6676) 4294967295)
                          (logand (ptr-read-u64 ctx 6688) 4294967295) (logand (ptr-read-u64 ctx 6692) 4294967295))
                        (extern-call fclose fp) (mode_window_snapshot ctx) 0)))) forms)
      ;; Parent and own-visible flags remain meaningful for an unmapped test window.
      (push `(defun navigation_structure (ctx)
               (if (and ,@(cl-loop for (slot label) in '((6544 0) (6552 1) (6560 2) (6568 3)) append
                                  `((= (extern-call strcmp (extern-call gtk_button_get_label (ptr-read-u64 ctx ,slot))
                                        (data-addr ,(intern (format "navigation_label_%d" label)))) 0)
                                    (= (extern-call gtk_widget_get_visible (ptr-read-u64 ctx ,slot)) 1)
                                    (= (extern-call gtk_widget_get_parent (ptr-read-u64 ctx ,slot)) (ptr-read-u64 ctx 6656))))
                        (= (extern-call gtk_widget_get_visible (ptr-read-u64 ctx 3320)) 1)
                        (= (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3280))
                           (extern-call gtk_revealer_get_child (ptr-read-u64 ctx 6504)))
                        (= (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3240))
                           (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3248)))
                        (= (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3680))
                           (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3688)))
                        (= (extern-call gtk_widget_get_parent (extern-call gtk_widget_get_parent
                             (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3240)))) (ptr-read-u64 ctx 6512))
                        (= (extern-call gtk_widget_get_parent (extern-call gtk_widget_get_parent
                             (extern-call gtk_widget_get_parent (ptr-read-u64 ctx 3680)))) (ptr-read-u64 ctx 6520))) 1 0)) forms)
      (let ((tail '(if (= (extern-call strcmp command (data-addr navigation_close_command)) 0)
                      (seq (if (= (ptr-read-u64 ctx 6584) 0) 0
                             (extern-call g_signal_emit_by_name
                               (ptr-read-u64 ctx (+ 6624 (- (ptr-read-u64 ctx 6584) 6504))) (data-addr clicked))) 1)
                    (if (= (extern-call strcmp command (data-addr navigation_snapshot_command)) 0) 1 0))))
        (dolist (branch dispatch) (setq tail (cl-subst tail 'NEXT branch)))
        (push `(defun emit_navigation_command (ctx command)
                 (let ((handled ,tail))
                   (seq (if (= handled 1) (navigation_snapshot ctx command) 0) handled))) forms)))
    (setq program
          (mapcar (lambda (form)
                    (cond ((and (eq (car-safe form) 'defun) (eq (cadr form) 'emit_command))
                           `(defun emit_command (ctx command)
                              (if (= (emit_navigation_command ctx command) 1) 0 ,(nth 3 form))))
                          ((and (eq (car-safe form) 'defun) (eq (cadr form) 'on_compact))
                           (cl-subst '(seq 0) '(extern-call gtk_widget_set_visible (ptr-read-u64 ctx 3280) show)
                             (cl-subst '(seq 0) '(extern-call gtk_widget_set_visible (ptr-read-u64 ctx 3272) show) form :test #'equal) :test #'equal))
                          (t form))) program))
    (append program (nreverse forms))))
